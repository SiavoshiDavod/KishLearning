@model SurveyWeb.Models.ResturantPersonelCourse

@{
    Layout = null;
}
@using (Html.BeginForm("ResturantPersonelCourseSave", "Resturant", FormMethod.Post, new {id = "FormResturantPersonelCourse" }))
{

    <div class="form-horizontal" style="margin:20px">
        @Html.HiddenFor(model => model.ResturantPersonelId)
        <div class="row Course-div">

            <div class="form-group ">
                @Html.LabelFor(model => model.CourseName1, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.CourseName1, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CourseName1, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group ">
                @Html.LabelFor(model => model.CourseDuration1, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.CourseDuration1, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CourseDuration1, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group ">
                @Html.LabelFor(model => model.CourseLocation1, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.CourseLocation1, new { htmlAttributes = new { @class = "form-control " } })
                    @Html.ValidationMessageFor(model => model.CourseLocation1, "", new { @class = "text-danger" })
                </div>
            </div>


            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="button" value="ثبت" class="btn btn-default" onclick="return ResturantPersonelCourseSave('')" />
                </div>
            </div>
        </div>
    </div>

}
