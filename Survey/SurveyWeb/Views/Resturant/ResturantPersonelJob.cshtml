@model List<SurveyWeb.Models.ResturantPersonelJob>
    
    <div>
        <input type="hidden" id="ViewBagpersonelId" value="@ViewBag.personelId" />
        <input type="submit" value="افزودن سوابق شغلی" class="btn btn-default" onclick="return AddJobPersonel('@ViewBag.personelId')" />
    </div>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>
                عنوان شغل
            </th>
            <th>
                نام محل کار
            </th>
            <th>
                تاریخ شروع به کار
            </th>
            <th>
                تاریخ خاتمه کار
            </th>
            <th>
                حذف
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>
                @item.LastJobPosition1
            </td>
            <td>
                @item.LastJobName1
            </td>
            
            <td>
                @item.LastStartDate1
            </td>
            <td>
                @item.LastEndDate1
            </td>
            <td>
                <button class="btn btn-danger " value="حذف" title="حذف" onclick="RemoveJobPersonel('@item.Id')">حذف</button>
            </td>
        </tr>
        }
    </tbody>
</table>