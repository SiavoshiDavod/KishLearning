    function RemovePersonel(id) {
        var url = '/Resturant/RemoveResturantPersonel?id='+id;
        var sf = function () { partialPageResturant(url, 'کارکنان') };
        confirmDelete(sf);
        }
    function FindResturantPersonel(id) {
        var ResturantId = '@Model.Id';
        var url = '/Resturant/FindResturantPersonel?ResturantId=' + ResturantId + '&id=' + id;
         pw.modal('FindResturantPersonelInModal', "ذخیره سازی پرسنل", url, null, 'modal-full', true, null, null);
    }

    function SaveResturantPersonel(id) {

           var success = function () {
          pw.closeModal('FindResturantPersonelInModal');
        OpenPersonel('@Model.Id');
            };

        var validate = $("#FormPersonel").valid();
        if (validate) {
            //setTimeout(success, 2000);
            pw.submitForm('FormPersonel', success);
        }

    }
</script>