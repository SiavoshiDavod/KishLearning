<script>
    $('.MyDate').MdPersianDateTimePicker();
    var fff = function () { $('.MyDate').attr('data-enabletimepicker', 'false') };
    setTimeout(fff, 1000);
    $(".fileChosen").change(function () {
        filename = this.files[0].name;
        $(".fileChosenText").html(filename);
    });
</script>
