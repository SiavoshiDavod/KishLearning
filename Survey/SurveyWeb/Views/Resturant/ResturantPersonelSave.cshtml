@model SurveyWeb.Models.ResturantPersonel

@{
    Layout = null;
}
@using (Html.BeginForm("SaveResturantPersonel", "Resturant", FormMethod.Post, new { enctype = "multipart/form-data", id = "FormPersonel" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="margin:20px">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.ResturantId)
        @Html.HiddenFor(model => model.CreatedDate)
        @Html.HiddenFor(model => model.ImageUrl)
        <div>
            <div class="form-group">
                @Html.LabelFor(model => model.ImageUrl, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @if (Model != null && !string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        @Html.HiddenFor(x => x.ImageUrl)
                        <a href="~/images/Resturant/@Model.ImageUrl"><img src="~/images/Resturant/@Model.ImageUrl" title="دانلود" height="50" /></a>
                    }
                    else
                    {
                        <label class="btn btn-default">
                            انتخاب عکس
                            <input accept=" image/*" class="fileChosen" type="file" hidden id="File" name="File">
                        </label><span class="fileChosenText"></span>
                        @Html.ValidationMessageFor(model => model.ImageUrl, "", new { @class = "text-danger" })
                    }

                </div>
            </div>
        </div>
        <h4 class="m-t-0 header-title" onclick="return toggleDiv('personality-div');"><b>مشخصات فردی</b><i class="title-fa fa fa-link"></i></h4>
        <hr />
        <div class="row personality-div">

            <div class="form-group col-md-4">
                <label class="control-label col-md-4">نام <span style="color:red">*</span></label>
