@model SurveyWeb.Models.ResturantPersonelEducation

@{
    Layout = null;
}
@using (Html.BeginForm("ResturantPersonelEducationSave", "Resturant", FormMethod.Post, new {id = "FormResturantPersonelEducation" }))
{

    <div class="form-horizontal" style="margin:20px">
        @Html.HiddenFor(model => model.ResturantPersonelId)
        <div class="row Education-div">

            <div class="form-group ">
                @Html.LabelFor(model => model.EducationId, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @*@Html.EditorFor(model => model.Education, new { htmlAttributes = new { @class = "form-control" } })*@
                    @Html.EducationDropDown("EducationId", false, false, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.EducationId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group ">
                @Html.LabelFor(model => model.EducationField, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.EducationField, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.EducationField, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group ">
                @Html.LabelFor(model => model.EducationLocation, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.EducationLocation, new { htmlAttributes = new { @class = "form-control " } })
                    @Html.ValidationMessageFor(model => model.EducationLocation, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group ">
                @Html.LabelFor(model => model.EducationAddressStay, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.EducationAddressStay, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.EducationAddressStay, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="button" value="ثبت" class="btn btn-default" onclick="return ResturantPersonelEducationSave('')" />
                </div>
            </div>
        </div>
    </div>

}
