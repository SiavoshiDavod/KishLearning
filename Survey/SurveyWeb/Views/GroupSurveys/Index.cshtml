@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/GroupSurveys/LoadList";
    ViewBag.Title = "گروه";
}

<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>
        </div>
    </div>
</div>
<div id="TadGoodsField">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("GroupSurveyGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList).
        SetCaption("گروه").
    SetOnLoadCompleteEvent("loadGroupSurveyGridCompleteEvent").
        UseColumns(SurveyWeb.Controllers.GroupSurveysController.GroupSurveyColumns)
)
    <script >
	function loadGroupSurveyGridCompleteEvent() {
		var ids = $("#GroupSurveyGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
			var cl = ids[i];
			ed = '<a class="ajaxLink"  href="/GroupSurveys/Create?Id=' + cl + '" title="ویرایش"><div class="fa fa-pencil"></div></a>';
			dl = '<a class="ajaxLink delete"href="/GroupSurveys/Delete?Id=' + cl + '" title="حذف"   ><div class="fa fa-times"></div></a>';
		    //de = '<a class="ajaxLink "href="/GroupSurveys/Details?Id=' + cl + '" title="جزئیات"   ><div class="fa fa-building"></div></a>';
			$('#GroupSurveyGrid').jqGrid('setRowData', ids[i], { act: ed + dl  });
		}
    }

    </script>
</div>




