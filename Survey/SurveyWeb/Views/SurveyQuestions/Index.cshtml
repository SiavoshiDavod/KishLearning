@model SurveyWeb.Models.SurveyQuestion
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/SurveyQuestions/LoadList?surveyEntityId="+Model.SurveyEntityId;
    ViewBag.Title = "سوالات";

}

<div class="row">

    <div class="col-md-2">
       <div style="display:inline">
           <a class=" btn-primary " href="/SurveyEntitys/Details?Id=@Model.SurveyEntityId" title="پیش نمایش">پیش نمایش</a>
           <a class=" btn-primary " href="/SurveyGroupQuestions/index?surveyEntityId=@Model.SurveyEntityId" title="گروه سوال">گروه سوال</a> 
       </div>
        <br />    ایجاد سوال<br />
       @foreach (var item in SurveyWeb.EnumExtention.GetEnumsProperty<SurveyWeb.Models.QuestionEnum>())
       {
           <a href="/SurveyQuestions/New?type=@item.Value&surveyEntityId=@Model.SurveyEntityId"><input class="btn btn-default" style="width:150px;margin:5px"  type="button" value="@item.Key"title="@item.Key" /></a><br />
       }
    </div>

        <div class="col-md-10">

            <div id="TadGoodsField">
                @using MVC.Controls

                @Html.Grid(
    new GridControl().SetName("SurveyQuestionGrid").
    SetPageSize(20).
    SetShrinkToFit(true).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList).
        SetCaption("سوالات").
    SetOnLoadCompleteEvent("loadSurveyQuestionGridCompleteEvent").
        UseColumns(SurveyWeb.Controllers.SurveyQuestionsController.SurveyQuestionColumns)
)
                <script >
	function loadSurveyQuestionGridCompleteEvent() {
		var ids = $("#SurveyQuestionGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
		    var cl = ids[i];
		    var surveyEntityId = $("#SurveyQuestionGrid").jqGrid('getCell', cl, 'SurveyEntityId');
		    ed = '<a class="ajaxLink"  href="/SurveyQuestions/Create?Id=' + cl + '&surveyEntityId=' + surveyEntityId + '" title="ویرایش"><div class="fa fa-pencil"></div></a>';
			dl = '<a class="ajaxLink delete"href="/SurveyQuestions/Delete?Id=' + cl + '" title="حذف"   ><div class="fa fa-times"></div></a>';
			de = '<a class="ajaxLink "href="/SurveyQuestions/Details?Id=' + cl + '" title="جزئیات"   ><div class="fa fa-building"></div></a>';
			$('#SurveyQuestionGrid').jqGrid('setRowData', ids[i], { act: ed + dl + de });
		}
    }

                </script>
            </div>
        </div>

</div>




