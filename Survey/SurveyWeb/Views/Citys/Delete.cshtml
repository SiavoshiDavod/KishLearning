@model SurveyWeb.Models.BaseInfo.City
@{
    ViewBag.Title = SurveyWeb.Models.Dictionary.ModelDictionary[typeof(SurveyWeb.Models.BaseInfo.City)]; ;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="form-group">
    @Html.LabelFor(model => model.DropDownTitle, htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.DisplayFor(model => model.DropDownTitle, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.DropDownTitle, "", new { @class = "text-danger" })
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Id)
    <div class="form-actions no-color">
        <input type="submit" value="حذف" class="btn btn-default" /> |
        @Html.ActionLink("بازگشت", "Index")
    </div>
}


