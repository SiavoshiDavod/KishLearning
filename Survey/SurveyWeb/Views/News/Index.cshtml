@model IEnumerable<SurveyWeb.Models.News>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/News/LoadList";
    ViewBag.Title = SurveyWeb.Models.Dictionary.ModelDictionary[typeof(SurveyWeb.Models.News)];
}

<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>
        </div>
    </div>
</div>
<div id="TadGoodsField">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("NewsGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList).
        SetCaption((string)ViewBag.Title).
    SetOnLoadCompleteEvent("loadNewsGridCompleteEvent").
        UseColumns(SurveyWeb.Controllers.NewsController.NewsColumns)
)
    <script >
	function loadNewsGridCompleteEvent() {
		var ids = $("#NewsGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
			var cl = ids[i];
			ed = '<a class="ajaxLink"  href="/News/Create?Id=' + cl + '" title="ویرایش"><div class="fa fa-pencil"></div></a>';
			dl = '<a class="ajaxLink delete"href="/News/Delete?Id=' + cl + '" title="حذف"   ><div class="fa fa-times"></div></a>';
		    de = '<a class="ajaxLink "href="/News/Details?Id=' + cl + '" title="جزئیات"   ><div class="fa fa-building"></div></a>';
		    $('#NewsGrid').jqGrid('setRowData', ids[i], { act: ed + dl + de });
		}
    }

    </script>
</div>




