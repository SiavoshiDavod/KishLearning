@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/Menus/LoadList";
    ViewBag.Title = SurveyWeb.Models.Dictionary.ModelDictionary[typeof(SurveyWeb.Models.Menu)];
    var user = (SurveyWeb.Models.User)ViewBag.User;
}

<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>
        </div>
    </div>
</div>
<div id="TadGoodsField">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("MenuGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList).
        SetCaption((string)ViewBag.Title).
    SetOnLoadCompleteEvent("loadMenuGridCompleteEvent").
        UseColumns(SurveyWeb.Controllers.MenusController.MenuColumns)
)
    <script >
	function loadMenuGridCompleteEvent() {
		var ids = $("#MenuGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
			var cl = ids[i];
			ed = '<a class="ajaxLink"  href="/Menus/Create?Id=' + cl + '" title="ویرایش"><div class="fa fa-pencil"></div></a>';
			dl = '<a class="ajaxLink delete"href="/Menus/Delete?Id=' + cl + '" title="حذف"   ><div class="fa fa-times"></div></a>';
			de = '<a class="ajaxLink "href="/Menus/Details?Id=' + cl + '" title="جزئیات"   ><div class="fa fa-building"></div></a>';
			var pe = "";
            @if (user.Permisstions.Any(x => x == SurveyWeb.Models.Permisstion.MenuSubs)){
			    @: pe = '<a class="ajaxLink "href="/MenuSubs/IndexByMenuId?Id=' + cl + '" title="زیرمنوها"   ><div style="margin: 3px;cursor: pointer;display: inline-block;">زیرمنوها </div></a>';//<div class="fa fa-calendar"></div>
			}
		    $('#MenuGrid').jqGrid('setRowData', ids[i], { act: ed + dl + de+pe });
		}
    }

    </script>
</div>




