@model SurveyWeb.Models.SurveyEntity

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    if (string.IsNullOrEmpty(Model.act))
    {
        Model.act = "/";
    }
}

<h2 class="text-center">  نظر سنجی @Model.Name</h2>

@{
    var list = Model.SurveyQuestions.OrderBy(x => x.SurveyOrder).ThenBy(x => x.SurveyGroupQuestionId).ToList();
    for (int i = 0; i < list.Count; i++)
    {
        SurveyWeb.Models.SurveyQuestion item = list[i];
        item.SurveyOrder = i + 1;
        var pageFooter = "سوال " + item.SurveyOrder + " از " + list.Count;
        int prev = 0;
        int next = 0;
        if (i != 0)
        {
            prev = list[i - 1].Id;
        }
        if ((i + 1) != list.Count)
        {
            next = list[i + 1].Id;
        }
        if (Model.IsShowInSinglePage)
        {
            <div id="@item.Id" class="table table-bordered">
                @Html.Partial("_p" + item.QuestionType.ToString(), item)
            </div>
        }
        else
        {
            <div id="@item.Id" class="PartialQuestions">
                @Html.Partial("_p" + item.QuestionType.ToString(), item, new ViewDataDictionary() { { "Next", next }, { "Prev", prev } })
                <div class="text-center">
                    @pageFooter
                </div>
            </div>
        }

    }
    if (Model.IsShowInSinglePage)
    {
<div class="text-center">
    <input type="button" title="ثبت" value="ثبت" class="btn btn-success" onclick="return saveSurveyForm()" />
</div>
