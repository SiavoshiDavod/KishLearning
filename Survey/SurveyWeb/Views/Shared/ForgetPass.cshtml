<section class="login-form page-section-ptb">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("ResetPass", "Home", FormMethod.Post, new { @class = "gray-form mt-2 clearfix" }))
                {
                    var m = (string)ViewBag.Message;
                    if (!string.IsNullOrEmpty(m))
                    {
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <span style="color:red">@m</span>
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    }
                    <div class="form-group">
                        @Html.Label("ایمیل خود را وارد کنید ")
                        @Html.Editor("email", "", new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    <div class="form-group">
                        <input type="submit" value="بازیابی کلمه عبور" class="button" />
                    </div>

                }
            </div>
        </div>
    </div>
</section>
