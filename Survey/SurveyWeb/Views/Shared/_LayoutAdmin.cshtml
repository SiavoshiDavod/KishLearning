        $(".PriceFormat").on('keyup', function () {
            try {
                var n = parseInt($(this).val().replace(/,/g, ''), 10);
                if (isNaN(n)) {
                    $(this).val('');
                } else {
                    $(this).val(n.toLocaleString());
                }
            } catch (e) {

            }
        });
        function PriceToNumber() {
            $('.PriceFormat').each(function () {
                $(this).val($(this).val().replace(/,/g, ''));
            });
            return true;
        }
