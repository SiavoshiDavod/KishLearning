    <script >
        function ShowTickets() {
            pw.post("/Ticket/LoadLastestAnswerd",
                null,
                'json',
                function (response) {
                    debugger;
                    if (response) {
                        var div = "";
                        $("#TicketCount").val(response.length);
                        for (var i = 0; i < response.length; i++) {
                            div += '<div class="media-body"> <h5 class="media-heading"></h5> <p class="m-0"> <small></small></p> </div>';
                        }
                        $("#ShowAllTicket").html(div);
                    } 
                });
            
        }
        jQuery(document).ready(function ($) {
           // ShowTickets()
            $('.counter').counterUp({
                delay: 100,
                time: 1200
            });
            $('.circliful-chart').circliful();
        });

        // BEGIN SVG WEATHER ICON
        if (typeof Skycons !== 'undefined') {
            var icons = new Skycons(
                { "color": "#3bafda" },
                { "resizeClear": true }
            ),
                list = [
                    "clear-day", "clear-night", "partly-cloudy-day",
                    "partly-cloudy-night", "cloudy", "rain", "sleet", "snow", "wind",
                    "fog"
                ],
                i;

            for (i = list.length; i--;)
                icons.set(list[i], list[i]);
            icons.play();
        };

    </script>
