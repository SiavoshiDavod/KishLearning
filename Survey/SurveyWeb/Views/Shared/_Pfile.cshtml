    function InsertFinalRequest() {
        if ($('#Id').val() == '')
        { showError('ثبت درخواست معتبر نمی باشد') } else {
            $('#UploadForm').ajaxForm({
                url: '@Url.Content("/Stocks/Request/AddFinal")' + '?Id=' + $('#IdRequest').val(),
                type: "POST",
                beforeSend: function () {
                    //$("div#Loader_").show();
                    LoadingPanel.Show();
                },
                success: function (data) {
                    //$("div#Loader_").hide();
                    LoadingPanel.Hide();
                    if (data.indexOf('showError') == 0) {
                        eval(data);
                    } else {
                        $('#RequestDetailsFinalDiv').parent().dialog('close');
                        showSuccess('پیوست های درخواست با موفقیت ثبت گردید . لطفا به کارتابل درخواست مراجعه شود', 'عملیات با موفقیت انجام شد', true);
