@Html.Partial("~/Views/Shared/Banner.cshtml")

@{
    SiteSetting.SiteSetting setting = (SiteSetting.SiteSetting)ViewBag.SiteSetting;
    var list = SurveyWeb.Biz.MenuBiz.Instance.GetActiveMenu();
    foreach (var item in list)
    {

        <section class="education page-section-ptb" style="background:url(lib/SeoHub/images/bg-element/01.png) no-repeat 150px 70px;">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="section-title text-center">
                            <span>میز خدمت @item.Title</span>
                            <h3 class="text-center">@item.Title</h3>
                        </div>
                    </div>
                    @if (item.MenuSubs != null && item.MenuSubs.Count > 0)
                    {
                        foreach (var submenu in item.MenuSubs@*.OrderBy(x => x.Order)*@)
{
if (string.IsNullOrEmpty(submenu.Url))
{
submenu.Url = "/Home/SubMenu/" + submenu.Id;
}
<div class="col-md-4">
    <div class="feature-box-01 round text-center">
        <div class="feature-box-img mb-2">
            <a href="@submenu.Url">
                <img class="img-fluid" src="~/images/MenuSub/@submenu.Image" alt="@submenu.Title">
            </a>

        </div>
        <div class="feature-box-info mt-2">
            <a href="@submenu.Url">
                <h5 class="text-blue mb-2">@submenu.Title</h5>
            </a>
        </div>
    </div>
</div>
}
}
                </div>
            </div>
        </section>
    }
}

<section class="our-blog page-section-ptb" style="padding:100px 0 0 0;">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="section-title text-center">
                    <span> بهترین </span>
                    <h3 class="text-center"> رستوران ها با موزیک زنده</h3>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="owl-carousel" data-nav-dots="false" data-nav-arrow="true" data-items="3"
                     data-xs-items="2" data-sm-items="2" data-md-items="3" data-lg-items="3" data-autoplay="false"
                     data-loop="true">
                    @{
                        var advertisingMusical = SurveyWeb.Biz.AdvertisingBiz.Instance.GetAllInView(false, true);
                        foreach (var item in advertisingMusical)
                        {
                            var typeAdverUrl = "/Home/AllAdvertising?typeId=" + item.Resturant.ResturantTypeId + "&typeName=" + item.Resturant.ResturantType.DropDownTitle;
                            <div class="item">
                                <div class="blog-entry">
                                    <div class="entry-image clearfix">
                                        <a href="/Home/Advertising/@item.Id"> <img class="img-fluid" src="~/Images/Advertising/@item.ImageUrl" alt="@item.Resturant.Name"></a>
                                    </div>
                                    <div class="blog-detail">
                                        <div class="entry-title mb-1">
                                            <a href="/Home/Advertising/@item.Id">@item.ResturantName</a>
                                        </div>
                                        <div class="entry-meta mb-1">
                                            <ul>
                                                <li><a href="@typeAdverUrl"><i class="ti-folder"></i> @item.Resturant.ResturantType.DropDownTitle</a></li>
                                                @*<li><a href="#"> @item.VisitCount<i class="ti-comments"></i></a></li>*@
                                                @*<li><a href="#"><i class="ti-calendar"></i> @item.CreatedDateShamsi</a></li>*@
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        }
                    }

                </div>
            </div>
        </div>
    </div>
</section>

