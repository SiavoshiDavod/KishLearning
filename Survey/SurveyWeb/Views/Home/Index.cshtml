                    @{
                        var teacherlist =  SurveyWeb.Biz.BoardDirectorBiz.Instance.FindAll();
                        foreach (var item in teacherlist)
                        {
                            var imeage = "/lib/SeoHub/images/team/02.png";
                            if (!string.IsNullOrEmpty(item.image)&& item.image!=".")
                            {
                                imeage ="/images/BoardDirector/"+item.image ;
                            }
                            <div class="item">
                                <div class="team">
                                    <div class="team-images">
                                        <img class="img-fluid" src="@imeage" alt="@item.FullName">
                                    </div>
                                    <div class="team-description">
