<section class="our-blog page-section-ptb">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="section-title text-center">
                    <span>اخبار مورد نیاز شما</span>
                    <h3 class="text-center">آخرین اخبار @setting.NameFa</h3>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="owl-carousel" data-nav-dots="false" data-nav-arrow="true" data-items="3"
                     data-xs-items="2" data-sm-items="2" data-md-items="3" data-lg-items="3" data-autoplay="false"
                     data-loop="true">
                    @{
                        var news = SurveyWeb.Biz.NewsBiz.Instance.GetActiveMenu();
                        foreach (var item in news)
                        {
                            <div class="item">
                                <div class="blog-entry">
                                    <div class="entry-image clearfix">
                                        <img class="img-fluid" src="~/Images/News/@item.ImageUrl" alt="@item.Title">
                                    </div>
                                    <div class="blog-detail">
                                        <div class="entry-title mb-1">
                                            <a href="/Home/News/@item.Id">@item.Title</a>
                                        </div>
                                        <div class="entry-meta mb-1">
                                            <ul>
                                                <li><a href="#"><i class="ti-folder"></i> @item.NewsGroup.Title</a></li>
                                                <li><a href="#"> @item.VisitCount<i class="ti-comments"></i></a></li>
                                                <li><a href="#"><i class="ti-calendar"></i> @item.CreatedDateShamsi</a></li>
                                            </ul>
                                        </div>
                                        <div class="entry-content">
                                            <p>
                                                @item.Summary
                                            </p>
                                            @if (item.Author != null)
                                            {
                                                <cite class="text-white">  @item.Author.FullName</cite>
                                            }
                                        </div>
                                        <div class="entry-share clearfix">
                                            <div class="entry-button">
                                                <a class="button arrow" href="/Home/News/@item.Id">
                                                    بیشتر بخوانید<i class="fa fa-angle-left"
                                                                    aria-hidden="true"></i>
                                                </a>
                                            </div>
                                            <div class="social list-style-none pull-left">
                                                <strong>انتشار: </strong>
                                                <ul>
                                                    <li>
                                                        <a href="#"> <i class="fa fa-facebook"></i> </a>
                                                    </li>
                                                    <li>
                                                        <a href="#"> <i class="fa fa-twitter"></i> </a>
                                                    </li>
                                                    <li>
                                                        <a href="#"> <i class="fa fa-pinterest-p"></i> </a>
                                                    </li>
                                                    <li>
                                                        <a href="#"> <i class="fa fa-dribbble"></i> </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        }
                    }

                </div>
            </div>
            <a class="button mt-3" href="/Home/Allnews">مشاهده همه اخبار</a>
        </div>
    </div>
</section>

<section class="newsletter page-section-ptb">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-12 text-center">
                <div class="newsletter-info">
                    <h4 class="text-white mb-3">مشترک خبرنامه ما شوید</h4>
                    <p class="mb-4 text-white">برای دریافت آخرین اخبار @setting.NameFa، با ثبت ایمیل خود، عضو خبرنامه ما شوید.</p>
                </div>
                <form class="form-inline d-inline" role="form" method="post" action="/Home/NewsSubscription">
                    <div class="row">
                        <div class="col-md-8 col-sm-8">
                            <div class="form-group">
                                <input type="email" class="form-control" id="Email" name="Email" placeholder="آدرس ایمیل خود را وارد کنید">
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4 text-right">
                            <input type="submit" value="حالا مشترک می شوم" class="button" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

