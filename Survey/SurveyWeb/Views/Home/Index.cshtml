                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="our-team page-section-ptb">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 mb-3">
                <div class="section-title text-center">
                    <span>منابع ارزشمند ما</span>
                    <h3 class="text-center">اعضای هیأت مدیره و همکاران ما</h3>
                </div>
            </div>
