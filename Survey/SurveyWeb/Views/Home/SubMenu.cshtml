@model SurveyWeb.Models.MenuSub

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.Title;
}
<div class="page-heading text-center">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <div class="contact-form-title text-center mb-4">
                    <h4 class="mb-1">@Html.DisplayFor(model => model.Title)</h4>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container">
    <div class="row" style="text-align: center;">

        @if (!string.IsNullOrEmpty(Model.Image) && string.IsNullOrEmpty(Model.Content))
        {
            <div class="col-12">
                <img  src="~/images/MenuSub/@Model.Image" title="@Model.Title" alt="@Model.Title" class="resp-img" />
            </div>
        }


        <div class="col-12">
            @Html.Raw(Model.Content)
        </div>
    </div>
</div>


<style>
    img {
        max-width: 100%;
        height: auto
    }
</style>
