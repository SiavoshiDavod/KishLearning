@model List<SurveyWeb.Models.JobBoard.JobPositionWrapper>
@using SurveyWeb.Models.JobBoard
@{
    ViewBag.Title = "همه موقعیت های شغلی";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .job-container {
        /*border: 1px solid #ddd;*/
        border-radius: 4px;
        padding: 5px;
        box-shadow: 0 0 15px 1px #ccc;
    }

    .job-title {
        color: #c93d31;
    }

        .job-title:hover {
            color: #f86255
        }
</style>
<section class="page-section-ptb">
    <div class="container">
        <div>
            <h4 class="text-center" style="line-height:35px">برای دیدن همه موقعیت های شغلی و ثبت درخواست شغلی ثبت نام کنید</h4>
            
            <div class="mb-5 mt-5 row">
                <div class="col-md-6 mb-2 text-center">
                    <a style="color: #fff" href="/home/RegisterCustomer">
                        <img src="~/Images/register.png" class="img-rounded" style="width:30%" />
                        <div style="color:#555;margin-top:10px;font-weight:600">ثبت نام کارجو</div>
                    </a>
                </div>
                <div class="col-md-6 mb-2 text-center">
                    <a style="color:#fff" href="/home/UserLogin">
                        <img src="~/Images/login.png" class="img-rounded" style="width:30%" />
                        <div style="color:#555;margin-top:10px;font-weight:600">ورود کارجو</div>
                    </a>
                </div>
            </div>
        </div>
        <h4 class="mb-5 text-center">@ViewBag.PageTitle</h4>

        @if (Model.Count != 0)
        {
            foreach (var item in Model)
            {
                <div class="job-container col-md-4 p-3">
                    <a href="/home/jobs/details/@item.ID">
                        <h2 class="job-title" style="font-size: 22px ">@item.Title</h2>
                    </a>
                    <div class=""><i class="fa fa-building mr-2"></i>@item.CompanyName</div>
                    <div class=""><i class="fa fa-map-marker mr-2"></i>@item.Location</div>
                    <div class=""><i class="fa fa-paperclip mr-2"></i>قرارداد @item.CooperationTypeName</div>
                    <div class="mr-2"><span>حقوق از</span> @item.SalaryFrom ريال <span>تا</span> @item.SalaryTo ريال</div>
                    @if (!string.IsNullOrEmpty(item.RequestStatusName))
                    {
                        if (item.RequestStatus == JobRequest.StatusType.Accepted)
                        {
                            <div class="btn btn-success pull-right"><i class="fa fa-check mr-4"></i>@item.RequestStatusName</div>
                        }
                        else if (item.RequestStatus == JobRequest.StatusType.Rejected)
                        {
                            <div class="btn btn-danger pull-right"><i class="fa fa-ban mr-4"></i>@item.RequestStatusName</div>
                        }
                        else
                        {
                            <div class="btn btn-default pull-right"><i class="fa fa-spinner mr-4"></i>@item.RequestStatusName</div>
                        }
                    }
                </div>
            }
        }
        else
        {
            <h2 class="mt-6" style="color:#c93d31">در حال حاضر آگهی ای ثبت نشده است</h2>
        }
    </div>
</section>