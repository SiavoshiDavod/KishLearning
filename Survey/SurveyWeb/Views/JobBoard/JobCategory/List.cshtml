
@using MVC.Controls

@Html.Grid(
new GridControl().SetName("JobCategoryGrid").
SetPageSize(10).
SetShrinkToFit(false).
SetIsAutoSize(true).
SetIsFilterToolbar(true).
IsRTL().
SetListUrl("/JobCategorys/LoadList").
    SetCaption((string)ViewBag.Title).
SetOnLoadCompleteEvent("loadJobCategoryGridCompleteEvent").
    UseColumns(SurveyWeb.Controllers.JobBoard.JobCategorysController.JobCategoryColumns)
)
<script >
	function loadJobCategoryGridCompleteEvent() {
		var ids = $("#JobCategoryGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
			var cl = ids[i];
			//ed = '<a class="ajaxLink"  href="/JobCategory/Find?Id=' + cl + '" title="ویرایش"><div class="fa fa-pencil"></div></a>';
			dl = '<a class="ajaxLink delete" onclick="remove(' + cl +')" title="حذف"   ><div class="fa fa-times"></div></a>';
		    //de = '<a class="ajaxLink "href="/JobCategory/Find?Id=' + cl + '" title="جزئیات"   ><div class="fa fa-building"></div></a>';
		    $('#JobCategoryGrid').jqGrid('setRowData', ids[i], { act: dl });
		}
    }

	 function remove(id) {
        var conf = window.confirm("آیا از حذف اطمینان دارید؟");
        if (conf == true) {
            $.ajax({
                type: "post",
                url: "/JobCategorys/Remove?id=" + id,
                success: function (resp) {
                    //alert("Item deleted successfully.");
                    $('#job-category-list').html(resp);
                },
                error: function () {
                    alert("عملیات با خطا مواجه شد.")
                }
            })
        }
    }

</script>