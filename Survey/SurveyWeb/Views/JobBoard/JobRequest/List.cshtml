
@using MVC.Controls

@Html.Grid(
new GridControl().SetName("JobRequestGrid").
SetPageSize(10).
SetShrinkToFit(false).
SetIsAutoSize(true).
SetIsFilterToolbar(true).
IsRTL().
SetListUrl("/JobRequest/LoadList").
    SetCaption((string)ViewBag.Title).
SetOnLoadCompleteEvent("loadJobRequestGridCompleteEvent").
    UseColumns(SurveyWeb.Controllers.JobBoard.JobRequestController.JobRequestColumns)
)
<script >
    function loadJobRequestGridCompleteEvent() {
        var ids = $("#JobRequestGrid").jqGrid('getDataIDs');
        for (var i = 0; i < ids.length; i++) {
            var cl = ids[i];
            ed = '<a class="ajaxLink edit"   onclick="find(' + cl + ')" title="ویرایش"><div class="fa fa-pencil"></div></a>';
            dl = '<a class="ajaxLink delete" onclick="remove(' + cl + ')" title="حذف"   ><div class="fa fa-times"></div></a>';
            //de = '<a class="ajaxLink "href="/JobPosition/Find?Id=' + cl + '" title="جزئیات"   ><div class="fa fa-building"></div></a>';
            $('#JobRequestGrid').jqGrid('setRowData', ids[i], { act: dl + ed });
        }
    }

    function remove(id) {
        var conf = window.confirm("آیا از حذف اطمینان دارید؟");
        if (conf == true) {
            $.ajax({
                type: "post",
                url: "/JobRequest/Remove?id=" + id,
                success: function (resp) {
                    //alert("Item deleted successfully.");
                    $('#job-request-list').html(resp);
                },
                error: function () {
                    alert("عملیات با خطا مواجه شد.")
                }
            })
        }
    }

    function find(id) {
        $.ajax({
            type: "post",
            url: "/JobRequest/Find?id=" + id,
            success: function (resp) {
                $("#job-request-details").html(resp)
                //alert("Item deleted successfully.");
                //$('#job-position-list').html(resp);
            },
            error: function () {
                alert("عملیات با خطا مواجه شد.")
            }
        })
    }

</script>