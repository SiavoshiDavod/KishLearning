@model double

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "اطلاع رسانی";
}
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">مبلغ اعتبار فراپیامک: @Model </h4>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="card-box">
            <div class="row">
                <div class="col-md-6">
                    <h4 class="m-t-0 header-title"><b> ارسال پیامک  </b></h4>
                    <p class="text-muted m-b-30 font-13">
                       
                    </p>

                    <form role="form" >
                        <div class="form-group">
                            <label for="exampleInputEmail1">موبایل/گروه</label>
                            @Html.BooleanDropDown("GroupOrMobile", "موبایل", "گروه", true)
                        </div>
                        <div class="form-group" id="mobileDiv">
                            <label for="exampleInputEmail1">شماره موبایل</label>
                            <input type="number" class="form-control" id="mobile" placeholder="09121234567">
                        </div>
                        <div class="form-group" id="GroupmobileDiv">
                            <label for="exampleInputEmail1">گروه</label>
                            @Html.RoleSendSmsDropDown("Groupmobile",true,false)
                        </div>
                        <div class="form-group">
                            <label >متن پیام</label>
                            <textarea id="content" class="form-control" rows="5"></textarea>
                        </div>
                        <button type="submit" class="btn btn-purple waves-effect waves-light" onclick="sendsms()">ارسال پیامک</button>
                    </form>
                </div>
                <div class="col-md-6">
                    <h4 class="m-t-0 header-title"><b> ارسال ایمیل</b></h4>
                    <p class="text-muted m-b-30 font-13">

                    </p>

                    <form role="form" >
                        <div class="form-group" >
                            <label for="exampleInputEmail1">ایمیل/گروه</label>
                            @Html.BooleanDropDown("GroupOrEmail","ایمیل","گروه",true)
                        </div>
                        <div class="form-group" id="emailDiv">
                            <label for="example-email">آدرس ایمیل</label>
                            <input type="email" id="email" name="example-email" class="form-control" placeholder="Email">
                        </div>
                        <div class="form-group" id="GroupemailDiv">
                            <label for="exampleInputEmail1">گروه</label>
                            @Html.RoleSendSmsDropDown("Groupemail", true, false)
                        </div>
                        <div class="form-group">
                            <label >عنوان ایمیل</label>
                            <input type="text" class="form-control" placeholder="عنوان ایمیل" id="subject">
                        </div>
                        <div class="form-group">
                            <label class="control-label">متن ایمیل</label>
                            @Html.ClassicEditor("body");
                            @*<textarea id="body" class="form-control"></textarea>*@
                        </div>
                        <button type="button" class="btn btn-purple waves-effect waves-light" onclick="sendEmail()">ارسال ایمیل</button>
                    </form>
                </div>
      
            </div>
        </div>
    </div>
</div>
<div class="row">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("EmailSmsGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
