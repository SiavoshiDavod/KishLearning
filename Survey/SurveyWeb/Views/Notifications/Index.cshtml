<script>
    function Mypost(url, data, dataType, successFunction, failFunction, viewLoading) {

    if (url === undefined || url === null || url.length === 0)
        return;
    if (data === undefined || data === null || data.length === 0)
        data = {};
    if (dataType === undefined || dataType === null || dataType.length === 0)
        dataType = 'json';

    if (viewLoading === undefined || viewLoading === null)
        //pw.openLoading();

        $.ajax({
            url: url,
            dataType: dataType,
            data: data,
            type: 'post',
            success: function (response) {
                if (successFunction !== undefined && successFunction !== null)
                    successFunction(response);
                //pw.closeLoading();

                if (response == true) {

                    SwalSuccessMessage('عملیات با موفقیت انجام شد');
                    //pw.notificationSuccess(response.Title, response.getMessage);
                } else {
                    SwalErrorMessage("error");
                    //pw.notificationError(response.Title, response.getMessage);
                }
            },
            fail: function () {
                if (failFunction !== undefined && failFunction !== null && failFunction.length > 0)
                    failFunction();
                // pw.closeLoading();
            }
        })

}

    function sendEmail() {
        var action = "/Notifications/SendEmail";
        var body=$('#body').val();
        var subject=$('#subject').val();
        var email = $('#email').val();
        var RolesId = $('#Groupemail').val();
        var GroupOr = $('#GroupOrEmail').val();
        if (GroupOr == "True") {
            Mypost(action, { body: body, subject: subject, To: email });
            reloadJqGrid('EmailSmsGrid');
        } else {
            Mypost(action + "Batch", { body: body, subject: subject, RolesId: RolesId });
        }
       
    }
    function sendsms() {
        var action = "/Notifications/SendSms";
        var mobile = $('#mobile').val();
        var GroupOr = $('#GroupOrMobile').val();
        var RolesId = $('#Groupmobile').val();
        var content = $('#content').val();
        if (GroupOr == "True") {
            Mypost(action, { mobile: mobile, content: content });
            reloadJqGrid('EmailSmsGrid');
        } else {
            Mypost(action + "Batch", { content: content, RolesId: RolesId });
        }
       
    }
    $("#GroupOrEmail").change(function () {
        GroupOrEmailChange(this.value);
    });
    $("#GroupOrMobile").change(function () {
        GroupOrMobileChange(this.value);
    });
    $(document).ready(function () {
        GroupOrEmailChange($("#GroupOrEmail").val());
        GroupOrMobileChange($("#GroupOrMobile").val());
    });
    function GroupOrEmailChange(val) {
        if (val == "True") {
            $("#emailDiv").show();
            $("#GroupemailDiv").hide();
        } else {
            $("#GroupemailDiv").show();
            $("#emailDiv").hide();
        }
    }

    function GroupOrMobileChange(val) {
        if (val == "True") {
            $("#mobileDiv").show();
            $("#GroupmobileDiv").hide();
        } else {
            $("#GroupmobileDiv").show();
            $("#mobileDiv").hide();
        }
    }
</script>