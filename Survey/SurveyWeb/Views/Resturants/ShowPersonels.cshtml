@model List<SurveyWeb.Models.ResturantPersonel>

@{
    Layout = null;
}

@if (Model?.Count() > 0)
{

    <table class="table table-bordered">
        @foreach (var item in Model)
        {
        <tr>
            <td> @item.Name</td>
            <td> @item.LastName</td>
            <td>
                <a href="~/images/Resturant/@item.ImageUrl" target="_blank">
                    <img src="~/images/Resturant/@item.ImageUrl" title="دانلود" height="50" />
                </a>
            </td>
        </tr>
        }

    </table>
}
else
{
    <span>
        موردی یافت نشد
    </span>
}

