@model IEnumerable<SurveyWeb.Models.ResturantMenu>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/ResturantMenus/LoadList";
    ViewBag.Title = SurveyWeb.Models.Dictionary.ModelDictionary[typeof(SurveyWeb.Models.ResturantMenu)];
}

<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@*@Html.ActionLink("افزودن", "Create")*@ @ViewBag.Title</h4>
        </div>
    </div>
</div>
<div id="TadGoodsField">
    <select id="Archive" name="Archive" onchange="reloadResturantResturantMenusGrid()">
        <option value="false">   @ViewBag.Title تایید نشده </option>
        <option value="true"> @ViewBag.Title تایید شده</option>
    </select>
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("ResturantMenuGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList).
        SetCaption((string)ViewBag.Title).
    SetOnLoadCompleteEvent("loadResturantMenuGridCompleteEvent").
        UseColumns(SurveyWeb.Controllers.ResturantMenusController.ResturantMenuColumns)
)
    <script >
        function loadResturantMenuGridCompleteEvent() {
            var ids = $("#ResturantMenuGrid").jqGrid('getDataIDs');
            for (var i = 0; i < ids.length; i++) {
                var cl = ids[i];
                //ed = '<a class="ajaxLink"  href="/ResturantMenus/Create?Id=' + cl + '" title="ویرایش"><div class="fa fa-pencil"></div></a>';
                //dl = '<a class="ajaxLink delete"href="/ResturantMenus/Delete?Id=' + cl + '" title="حذف"   ><div class="fa fa-times"></div></a>';
                de = '<a class="ajaxLink "href="/ResturantMenus/Details?ResturantMenuId=' + cl + '" title="جزئیات غذاومحتویات آن"   ><div class="fa fa-building"></div></a>';
                 accept = '<a class="" onclick="confirmResturantMenu(\'' + cl + '\',true)"  title="تایید"   ><div class="fa fa-check"></div></a>';
                 accept += '<a class="" onclick="confirmResturantMenu(\'' + cl + '\',false)"  title="عدم تایید"   ><div class="fa fa-close"></div></a>';

                if ($("#Archive").val() == "true") {
                    accept = '<a class="" onclick="confirmResturantMenu(\'' + cl + '\',false)"  title="عدم تایید"   ><div class="fa fa-close"></div></a>';
                }
                $('#ResturantMenuGrid').jqGrid('setRowData', ids[i], { act: de +accept });
            }
        }
          function reloadResturantResturantMenusGrid() {
            var url = '@urlList' + '?Archive='+$("#Archive").val();
            reloadJqGrid("ResturantMenuGrid",url);
        }

        function confirmResturantMenu(id,accept) {
        //e.preventDefault();
        Swal.fire({
            title: accept?'منو تایید شود؟ ':'دلیل رد منو را ذکر کنید',
            input: 'text',
            inputAttributes: {
                autocapitalize: 'off'
            },
            showCancelButton: false,
            confirmButtonText: 'ثبت',
            showLoaderOnConfirm: false,

            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.value) {
                pw.post("/ResturantMenus/Accept?desc=" + result.value+'&id='+id+'&accept='+accept,
                    { desc:  result.value,id:id,accept:accept },
                    'json',
                    function (response) {
                       if (response.success) {
                           SwalSuccessMessage("");
                           reloadResturantResturantMenusGrid();
                        } else {
                            showError(response.ErrorMessage);
                        }
                    });
                return false;
            }
        })
        return false;
    }
    </script>
</div>