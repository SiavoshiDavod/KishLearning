@model SurveyWeb.Models.CheckList.CheckListItem

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/CheckListItem/LoadList?checkListId="+Model.CheckListId;
    ViewBag.Title = "آیتم های تعریف ارزیابی";
}
<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create",new { CheckListId=Model.CheckListId }) </h4>
        </div>
    </div>
</div>
<div id="TadGoodsField">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("CheckListGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList).
        SetCaption("تعریف آیتم ارزیابی").
    SetOnLoadCompleteEvent("loadGridCompleteEvent").
        UseColumns(SurveyWeb.Controllers.CheckList.CheckListItemController.Columns)
)
    <script type="text/javascript">
	function loadGridCompleteEvent() {
        var ids = $("#CheckListGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
            var cl = ids[i];
            var rowData = $("#CheckListGrid").getRowData(cl);
            ed = '<a class="ajaxLink"  href="/CheckListItem/Create?checkListId=' + rowData.CheckListId+'&Id=' + cl + '" title="ویرایش"><div class="fa fa-pencil"></div></a>';
            dl = '<a class="ajaxLink delete"href="/CheckListItem/Delete?Id=' + cl + '" title="حذف"   ><div class="fa fa-times"></div></a>';
            de = '<a class="ajaxLink "href="/CheckListItem/Details?Id=' + cl + '" title="جزئیات"   ><div class="fa fa-building"></div></a>';
            $('#CheckListGrid').jqGrid('setRowData', ids[i], { act: ed + dl + de });
		}
    }

    </script>
</div>
