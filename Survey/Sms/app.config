<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="SendSoap"/>
            </basicHttpBinding>
            <customBinding>
                <binding name="SendSoap12">
                    <textMessageEncoding messageVersion="Soap12"/>
                    <httpTransport/>
                </binding>
            </customBinding>
        </bindings>
        <client>
            <endpoint address="http://api.payamak-panel.com/post/Send.asmx" binding="basicHttpBinding" bindingConfiguration="SendSoap" contract="FaraPayamakSendSMS.SendSoap" name="SendSoap"/>
            <endpoint address="http://api.payamak-panel.com/post/Send.asmx" binding="customBinding" bindingConfiguration="SendSoap12" contract="FaraPayamakSendSMS.SendSoap" name="SendSoap12"/>
        </client>
    </system.serviceModel>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/></startup></configuration>
