    function getRoot(id) {
        if (id == "#")
            return null;
        var node = $("#RolePermissionTreeSelectorDiv").jstree(true).get_node(id);
        if (node.parent == "#")
            return node;
        else {
            node = getRoot(node.id);
            return node;
        }

