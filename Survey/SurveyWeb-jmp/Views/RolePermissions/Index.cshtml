<script type="text/javascript">
    function selectStockActivityTreeSelector() {
        var selectedIds = [];
        var selectedTitles = [];

        var selectedElms = $('#RolePermissionTreeSelectorDiv').jstree("get_selected", true);
        $.each(selectedElms, function () {

            selectedIds.push(Number(this.id));
            selectedTitles.push(this.text);
        });
        $('#StockActivityIdSelected').val(selectedIds.join(','));
        $('#StockActivityNameSelected').val(selectedTitles.join('|'));
        var datatopost = JSON.stringify(selectedIds);
        pw.post("@urlpost",
                { permission: datatopost },
                'json',
                function (response) {
                    debugger;
                    if (response) {
                        location.reload();
                        SwalSuccessMessage("");
                    } else {
                        showError("خطا");
                    }
                });
    }

    $('#RolePermissionTreeSelectorDiv').on('loaded.jstree', function () {
        selectedIdsArr = [];
    @foreach (var item in permissions)
        {
            int val = (int)item;
            @: selectedIdsArr.push(@val);
                }
        for (var i = 0; i < selectedIdsArr.length; i++) {
            if (selectedIdsArr[i] != '') {
                $("#RolePermissionTreeSelectorDiv").jstree("select_node", selectedIdsArr[i]);
                var id1 = '#RolePermissionTreeSelectorDiv li[id=' + selectedIdsArr[i] + ']';
            }
        }
    });

