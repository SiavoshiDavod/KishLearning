@model SurveyWeb.Models.UserComment
@*@{
    string header = "";
    if (Model == null || Model.PageTypeId == SenakLearn.Models.PageType.None)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
        header = "<div class='page-heading text-center'><div class='container'> <h2>ثبت نظرات</h2></div></div>";
    }

}

@Html.Raw(header)*@


    @using (Html.BeginForm("UserComment", "Home", FormMethod.Post, new { @class = "contact" }))
    {
        <div class=" gray-form row">
            @*@Html.Partial("~/Views/Users/_PartialGoogleRecapcha.cshtml", "login")*@
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            @Html.HiddenFor(x => x.PageTypeId)
            @Html.HiddenFor(x => x.TypeId)
            <div class="col-md-3">
                <div class="form-group">
                    <input type="text" class="form-control" id="Email" name="Email" placeholder="ایمیل">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <input type="text" class="form-control" id="Name" name="Name" placeholder="نام">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <input type="text" class="form-control" id="Mobile" name="Mobile" placeholder="تلفن">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <input type="text" class="form-control" id="Title" name="Title" placeholder="موضوع">
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-group">
                    @Html.TextAreaFor(x => x.Description, 7, 10, new { @class = "form-control", @placeholder = " نظرتان را بنویسید" })
                </div>
            </div>
            <div class="col-md-12">
                <input class="button red" id="submit" type="submit" value="ثبت نظر" />
            </div>
        </div>
    }
        
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}