<section class="page-section-ptb sec-relative">
    <div class="side-content-image">
        <img class="img-fluid center-block" src="~/lib/SeoHub/images/bg-element/04.png" alt="">
    </div>
    @{ var org = SurveyWeb.Biz.OrgIntroBiz.Instance.GetAllSync(); string classActive = "active";}
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="section-title text-center">
                    <span>آشنائی با @setting.NameFa</span>
                    <h3 class="text-center">معاونتها و مدیریتها</h3>
                </div>


                <ul class="nav nav-tabs justify-content-center" role="tablist">
                    @foreach (var item in org)
                    {
                        <li role="presentation"><a class="@classActive" href="#@item.Divid" aria-controls="@item.Divid" role="tab" data-toggle="tab">@item.Name</a></li>
                        classActive = "";
                    }


                </ul>


                <div class="tab-content">
                    @{
                        classActive = "active";
                        foreach (var item in org)
                        {
                            <div role="tabpanel" class="tab-pane @classActive" id="@item.Divid">
                                @{ classActive = "fade";}
                                <div class="row">
                                    @if (!item.IsImageDirectionLeft)
                                    {
                                        <div class="col-lg-6 col-sm-6">
                                            <img class="img-fluid" src="~/Images/orgintro/@item.ImageUrl" alt="">
                                        </div>
                                    }

                                    <div class="col-lg-6 col-sm-6">
                                        <h5 class="mb-2">@item.Name</h5>

                                        @Html.Raw(item.Summery)
                                        <a class="button mt-3" href="/Home/OrgIntro/@item.Id">مشاهده همه اطلاعات</a>
                                    </div>
                                    @if (item.IsImageDirectionLeft)
                                    {
                                        <div class="col-lg-6 col-sm-6">
                                            <img class="img-fluid" src="~/Images/orgintro/@item.ImageUrl" alt="">
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }


                </div>
            </div>
        </div>
    </div>
</section>
