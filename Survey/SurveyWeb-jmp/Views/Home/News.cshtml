                    <div class="row">
                        @foreach (var new1 in news)
                        {
                        <div class="col-xs-6 col-lg-6 col-md-6 col-sm-6">
                            <div class="navigation-next">
                                <a href="/Home/News/@new1.Id">
                                    <img class="img-fluid"  src="~/Images/News/@new1.ImageUrl" alt="@new1.Title">
                                    <div class="port-arrow">
                                        <i class="fa fa-angle-right"></i>
                                    </div>
                                    <span>@new1.Title</span>
                                </a>
                            </div>
                        </div>
                        }
                        
