            <div class="col-md-9">
                <div class="blog-entry mb-3">
                    <div class="entry-image clearfix">
                        <img class="img-fluid" src="~/Images/News/@Model.ImageUrl" alt="@Model.Summary" >
                    </div>
                    <div class="blog-detail mt-3">
                        <div class="entry-title mb-1">
                            <a href="#">@Model.Title</a>
                        </div>
                        <div class="entry-meta mb-1">
                            <ul>
                                <li><a href="#"><i class="ti-folder"></i> @Model.NewsGroup.Title</a></li>
                                <li><a href="#"> @Model.VisitCount<i class="ti-comments"></i></a></li>
                                <li><a href="#"><i class="ti-calendar"></i> @Model.CreatedDateShamsi</a></li>
                            </ul>
                        </div>
                        <div class="entry-content">
                            @Html.Raw(Model.Description)
                        </div>
                        <div class="entry-share clearfix">

                            <div class="social list-style-none float-left">
