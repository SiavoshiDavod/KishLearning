@model SurveyWeb.Models.News
    <script>
        $("#searchButton").click(function () {
            searchFilter()
        });
        function searchFilter() {
            var search = $("#searchInput").val();
            debugger;
            if (search != "") {
                window.location.href = '/Home/Allnews?search=' + search;
            }
            return false;
        }
    </script>
<section class="blog-single page-section-ptb">
    <div class="container">


        <div class="row">
            <div class="col-md-3">
                <div class="sidebar-widgets-wrap m-0">
                    <div class="sidebar-widget">
                        <h5>جستجو</h5>
                        <div class="widget-search">
                            <i id="searchButton" onclick="return searchFilter();" class="fa fa-search"></i>
                            <input type="search" class="form-control placeholder" id="searchInput" placeholder="جستجو . . .">
                        </div>
                    </div>
                    <div class="sidebar-widget">
                        @if (Model.Author != null)
                        {
                            <h5>درباره نویسنده</h5>
                            <p>@Model.Author.Description </p>
                            <p>@Model.Author.FullName</p>
                        }
                    </div>
                    <div class="sidebar-widget">
                        <h5>آخرین خبرها</h5>
                        @{
                            var news = SurveyWeb.Biz.NewsBiz.Instance.GetActiveMenu(3,Model.Id);
                            foreach (var item1 in news)
                            {
                                <div class="recent-post">
                                    <div class="recent-post-info">
                                        <a href="/Home/News/@item1.Id">@item1.Title</a>
                                        <span><i class="ti-calendar"></i> @item1.CreatedDateShamsi </span>
                                    </div>
                                </div>
                            }
                        }
                      
                    </div>
                    <div class="sidebar-widget">
                        <h5>گروه خبرها</h5>
                        <div class="widget-link">
                            <ul>
                                @{
                                    var group = SurveyWeb.Biz.NewsGroupBiz.Instance.DropDown();
                                    foreach (var item2 in group)
                                    {
                                        var href = "/Home/Allnews?groupId=" + item2.Value + "&group=" + item2.Text;
                                        <li>
                                            <a href="@href"> <i class="fa fa-angle-double-left"></i> @item2.Text </a>
                                        </li>
                                    }
                                }
                            
                            </ul>
                        </div>
                    </div>
