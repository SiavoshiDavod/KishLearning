@model IEnumerable<SurveyWeb.Models.SurveyGroupQuestion>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "گروه سوال";
}
<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create", new {  surveyEntityId = ViewBag.SurveyEntityId }) 
                <a class="btn btn-primary" href="/SurveyQuestions/index?surveyEntityId=@ViewBag.SurveyEntityId" title=" سوالات"> سوالات</a>
            </h4>
        </div>
    </div>
</div>

<table class="table">
    <tr>
        @*<th>
            @Html.DisplayNameFor(model => model.SurveyEntity.Name)
        </th>*@
        <th>
            @Html.DisplayNameFor(model => model.SurveyGroupQuestionTitle)
        </th>
        @*<th>
            @Html.DisplayNameFor(model => model.CreatedDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UpdateDate)
        </th>*@
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        @*<td>
            @Html.DisplayFor(modelItem => item.SurveyEntity.Name)
        </td>*@
        <td>
            @Html.DisplayFor(modelItem => item.SurveyGroupQuestionTitle)
        </td>
        @*<td>
            @Html.DisplayFor(modelItem => item.CreatedDate)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.UpdateDate)
        </td>*@
        <td>
            @Html.ActionLink("ویرایش", "Create", new { id=item.Id, surveyEntityId=item.SurveyEntityId }) |
            @*@Html.ActionLink("Details", "Details", new { id=item.Id }) |*@
            @Html.ActionLink("حذف", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>
