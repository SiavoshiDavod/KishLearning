@model IEnumerable<SurveyWeb.Models.Cartable>
@{
    var classActive = "active";
}

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/Complaints/LoadList?cartableId=";
    ViewBag.Title = SurveyWeb.Models.Dictionary.ModelDictionary[typeof(SurveyWeb.Models.Complaint)];
}
<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>
        </div>
    </div>
</div>
<div class="card-box">
    <ul class="nav nav-pills m-b-30 ">
        @foreach (var item in Model)
        {
            if (item.Id != 0)
            {
                classActive = "";
            }
            else
            {
                classActive = "active";
            }
            <li class="@classActive">
                <a href="#TabCartable-@item.Id" onclick="return ReloadGridByTab('@item.Id')" data-toggle="tab" aria-expanded="true">@item.Name</a>
            </li>
        }
    </ul>
    <div class="tab-content br-n pn">

        @using MVC.Controls
        @foreach (var item in Model)
        {
            if (item.Id != 0)
            {
                classActive = "";
            }
            else
            {
                classActive = "active";
            }
            <div id="TabCartable-@item.Id" class="tab-pane @classActive">
                <div class="row">
                    @Html.Grid(
    new GridControl().SetName("GridName" + item.Id).
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList + item.Id).
        SetCaption(item.Name).
    SetOnLoadCompleteEvent("loadCartableGridCompleteEvent").
        UseColumns(SurveyWeb.Controllers.ComplaintsController.ComplaintColumns)
)
                </div>
            </div>
        }

    </div>
</div>

<script>
    var stepsOfCartable = JSON.parse('@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model))');

    function ReloadGridByTab(id) {
        reloadJqGrid("GridName" + id);
        return false;
    }
    function ChangeCartableState(from, entityId) {
        //var SelectdList = element.next();
        //var val = $("#" + idSelectdList).val();
        var to = $("#selectedCartable" + entityId).val();
        var url = "/CartableLogs/Create";
        var cartableType = "Complaint";

        Swal.fire({
            title: ' توضیحات انتقال کارتابل',
            input: 'text',
            inputAttributes: {
                autocapitalize: 'off'
            },
            showCancelButton: false,
            confirmButtonText: 'ثبت و انتقال',
            showLoaderOnConfirm: false,

            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.value) {

                pw.post(url,
               { to: to, cartableType: cartableType, description: result.value, from: from, entityId: entityId },
               'json',
               function (response) {
                   if (response) {
                       SwalSuccessMessage("");
                       return ReloadGridByTab(from);
                   } else {
                       showError("خطا");
                   }
               });
                return false;
            }
        })


        return false;
    }
    function loadCartableGridCompleteEvent(data) {
        var ids = $("#GridName" + data.CartableId).jqGrid('getDataIDs');
        var selectedList = '';
        var selectedListOption = '';
        if (data.CartableId != "0" ) {
            selectedList = '<span class="fa fa-check" onclick="return ChangeCartableState(this)"></span><select>';
            for (var j = 0; j < stepsOfCartable.length; j++) {
                if (stepsOfCartable[j].Id == data.CartableId) {
                    for (var a = 0; a < stepsOfCartable[j].From.length; a++) {
                        selectedListOption += '<option  value="' + stepsOfCartable[j].From[a].To + '" >' + stepsOfCartable[j].From[a].ToName + '</option>';
                    }
                }
            }
            if (selectedListOption == '') {
                selectedList = '';
            } else {
                selectedList += selectedListOption;
                selectedList += "</select>";
            }
        }

        for (var i = 0; i < ids.length; i++) {
            var cl = ids[i];
            //ed = '<a class="ajaxLink"  href="/Complaints/Create?Id=' + cl + '" title="ویرایش"><div class="fa fa-pencil"></div></a>';
            //dl = '<a class="ajaxLink delete"href="/Complaints/Delete?Id=' + cl + '" title="حذف"   ><div class="fa fa-times"></div></a>';
            de = '<a class="ajaxLink " onclick="return OpenModalLog(\'/Complaints/Details?Id=' + cl + '\',\'جزئیات \')" title="جزئیات"   ><div class="fa fa-building"></div></a>';

            log = '<a class="ajaxLink " onclick="return OpenModalLog(\'/CartableLogs/Index?id=' + cl + '&cartableType=Complaint\',\'لاگ کارتابل\')" title="لاگ کارتابل"   ><div class="fa fa-calendar"></div></a>';

            var selectedListById = selectedList.replace("(this)", "(" + data.CartableId + "," + cl + ")").replace("<select>", "<select id=selectedCartable" + cl + " >")
            $("#GridName" + data.CartableId).jqGrid('setRowData', ids[i], { act: selectedListById + de + log });
        }
    }
    function OpenModalLog(url, title) {
        pw.modal('CartableLogInModal', title, url, null, 'modal-lg', true, null, null);
        return false;
    }
</script>
