@model IEnumerable<SenakLearn.Models.learn_cours>

@{
    ViewBag.Title = "فهرست دوره های من " ;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/TeacherCours/LoadList";
}
<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create",new { @class="page-title"}) </h4>
        </div>
    </div>
</div>

<div id="TadGoodsField" class="row">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("CourseesGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetSortName("id").
    SetListUrl(urlList).
        SetCaption("فهرست دوره های من").
    SetOnLoadCompleteEvent("loadCourseesGridCompleteEvent").
        UseColumns(SenakLearn.Areas.Admin.Controllers.CoursController.CourseColumns)
)
    <script type="text/javascript">
	function loadCourseesGridCompleteEvent() {
		var ids = $("#CourseesGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
			var cl = ids[i];
			ed = '<a class="ajaxLink"  href="/TeacherCours/edit?Id=' + cl + '" title="ویرایش"><div class="tableEditLink">ویرایش</div></a>';
			dl = '<a class="ajaxLink delete"href="/TeacherCours/Delete?Id=' + cl + '" title="حذف"   ><div class="tableDeleteLink">حذف</div></a>';
			de = '<a class="ajaxLink "href="/TeacherOfflineVideo/IndexAll?learn_coursId=' + cl + '" title="ویدیو"   ><div class="tableDeleteLink">ویدیو</div></a>';
			$('#CourseesGrid').jqGrid('setRowData', ids[i], { InterviewPathVideo: ed + dl + de });
		}
    }

    </script>
</div>



