        <dd>
            @Html.DisplayFor(model => model.doc)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.doc2)
        </dt>

        <dd>
            @Html.Raw(Model.doc2)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.status)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.status)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.image)
        </dt>

