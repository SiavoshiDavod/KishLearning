        function ShowQuestionById(id) {
            var currentShow = $("[name='" + currentShowId + "']");
            var parent = currentShow.parent().parent().parent().parent().parent();
            var req = false;
            if (parent.hasClass("AzmoonAnswerMultiOption")  && parent.hasClass("required")) {
                var selected = currentShow.length;
                if (selected==0) {
                     req = true;
                }
            }
            if (currentShow.hasClass("required") ) {
                var currentValue = currentShow.val();
                if (currentShow.type == "checkbox" ) {
                    var selected = $('input[name="' + idselected + '"]:checked').length;
                    if (selected == 0) {
                        req = true;
                    }
                }
                if (currentValue == '') {
                      req = true;
                }

            }
            if (req == true) {
                         showError("پاسخ به این سوال اجباری است");
                         return;
                    }

            if (parent.hasClass("AzmoonAnswerMultiOption")) {
                var minCount =Number( parent[0].dataset.min);
                var maxCount = Number(parent[0].dataset.max);
                var idselected = parent[0].id;
                var selected = $('input[name="' + idselected + '"]:checked').length;

                if (minCount > 0 && selected <minCount) {
                    showError("حداقل " + minCount + " گزینه را انتخاب کنید");
                    return;
                }
                if (maxCount > 0 && selected > maxCount) {
                    showError("حداکثر " + maxCount + " گزینه را انتخاب کنید");
                    return;
                }
                if (selected == 0 && parent.hasClass("required")) {
                    showError("پاسخ به این سوال اجباری است");
                    return;
                }
            }
            $('.PartialQuestions').each(function (index, value) {
                //console.log('div' + index + ':' + $(this).attr('id'));
                $(this).hide();
            });
            $('#' + id).show();
            currentShowId = id;
        }

        ShowQuestionById('@list[0].Id');

