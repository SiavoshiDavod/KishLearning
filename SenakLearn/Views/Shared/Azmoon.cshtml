        function confirmTimeDurationMili(timeDurationMili) {
        Swal.fire({
            title: 'مدت زمان آزمون',
            text: "مدت این آزمون "+"@Model.TimeDuration"+" دقیقه می باشد و پس از کلیک روی دکمه شروع ، آزمون به صورت خودکار پس از گذشت این زمان به پایان می رسد!",
            type: 'warning',
            showCancelButton: false,
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'شروع آزمون!',
        }).then((result) => {
            if (result.value) {
                window.setTimeout(function () { saveAzmoonForm(); }, timeDurationMili);
                var msg = "آزمون پس از " + "@Model.TimeDuration" + ". دقیقه به صورت خودکار به پایان می رسد! ";
                debugger;
                if ('@Model.UserIdCurrent' == '0')
                    msg += "در صورت عدم ورود امکان صدور کارنامه بعد از آزمون وجود ندارد ! <a href='/users/login'>ورود</a>";
                Swal.fire(
                    'مدت آزمون!',
                    msg,
                    'success'
                )
            }
        });
        return false;
