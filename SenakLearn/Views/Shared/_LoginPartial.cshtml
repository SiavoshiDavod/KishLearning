@if (User.Identity.IsAuthenticated)
{
    <div class="flex items-center gap-3">
        <a href="/Dashboard" class="bg-brand-50 text-brand-700 font-medium px-4 py-2 rounded-xl text-sm hover:bg-brand-100 transition flex items-center gap-2">
            <i class="fa fa-user-circle text-brand-600 text-base"></i>
            <span title="پنل کاربری"> @User.Identity.Name</span>
        </a>
        <a href="@Url.Action("Logout", "Users")" class="text-gray-500 hover:text-red-600 text-sm p-2 transition" title="خروج از حساب">
            <i class="fa fa-sign-out text-base"></i>
        </a>
    </div>
}
else
{
    <div class="flex items-center gap-2">
        <a href="@Url.Action("Login", "Users")" class="text-gray-700 hover:text-brand-600 font-medium px-4 py-2 text-sm transition">ورود</a>
        <a href="@Url.Action("Register", "Users")" class="bg-brand-600 hover:bg-brand-700 text-white font-medium px-4 py-2 rounded-xl text-sm shadow-sm transition">ثبت‌نام رایگان</a>
    </div>
}
