@model SenakLearn.Models.SurveyQuestion
@if (ViewBag.Layout != null)
{
    Layout = ViewBag.Layout;
}
@if (Model?.Id > 0)
{
    if (Model.SurveyAnswers?.Count > 0)
    {
        var result=Model.SurveyQuestionOptions.Select(x=>new SenakLearn.Models.wrapper.ChartVm { Id=x.Id.ToString(), QuestionOption=x.QuestionOption,Count=0}).ToList();
        string pieId = "CreatePieChart" + Model.Id;
        <td class="PieChart">
            <a title="نمایش نمودار" id="@pieId" style="cursor:pointer"> <span class="	fa fa-pie-chart"></span></a>
        </td>
        foreach (var answer in Model.SurveyAnswers.Where(z => !string.IsNullOrWhiteSpace(z.SurveyQuestionOptionId)))
        {
            var options = Model.SurveyQuestionOptions.FirstOrDefault(x => x.Id.ToString() == answer.SurveyQuestionOptionId.Trim());
            if (options != null)
            {
                var res=result.First(x => x.Id == answer.SurveyQuestionOptionId);
                res.Count= res.Count + 1;
                <td>
                    @options.QuestionOption
                </td>
            }
        }
        <script>
            $("#@pieId").click(function () {
                var result = '@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(result))';
                return CreatePieChart(result,'@Model.Question','@Model.QuestionTypeName','@Model.QuestionImageUrl','@Model.Id')
            });
        </script>
    }
    else
    {

        if (!string.IsNullOrEmpty(Model.QuestionImageUrl))
        {
            @Html.Raw($"<img src='~/images/Question/{ Model.QuestionImageUrl} { (Model.Height > 0 ? " height='" + Model.Height + "'" : "")}{ (Model.Width > 0 ? " width='" + Model.Width + "'" : "")} />")
        }
        <div class="QuestionSurvey">
            @Model.Question
        </div>
        <div class="QuestionSurvey">
            <select class="SurveyAnswer " id="@Model.Id" name="@Model.Id">
                @if (!Model.required)
                {
                    <option value="">انتخاب کنید</option>
                }
                @if (Model.SurveyQuestionOptions?.Count > 0)
                {
                    foreach (var item in Model.SurveyQuestionOptions)
                    {
                        string selected = "";
                        //if (item.Id.ToString() == value)
                        //{
                        //    selected = "selected";
                        //}
                        <option value="@item.Id" @selected>@item.QuestionOption</option>
                    }
                }
            </select>
        </div>
        <div class="QuestionSurveyFooter">
            @{
                int? next = null;
                int? prev = null;
                if (ViewData["Next"] != null)
                {
                    next = (int?)ViewData["Next"];
                }
                if (ViewData["Prev"] != null)
                {
                    prev = (int?)ViewData["Prev"];
                }
                if (next != null && next > 0 && prev != null && prev > 0)
                {
                    <input type="button" title="بعدی" value="بعدی" class="btn btn-warning" onclick="return ShowQuestionById('@next')" />
                    <input type="button" title="قبلی" value="قبلی" class="btn btn-warning" onclick="return ShowQuestionById('@prev')" />
                }
                else if (next != null && next > 0)
                {
                    <input type="button" title="شروع" value="شروع" class="btn btn-warning" onclick="return ShowQuestionById('@next')" />
                }
                else if (prev != null && prev > 0)
                {
                    <input type="button" title="ثبت" value="ثبت" class="btn btn-success" onclick="return saveSurveyForm()" />
                }
            }
        </div>
                    }
                }

