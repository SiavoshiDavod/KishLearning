@{
    var setting = ViewBag.SiteSetting as SiteSetting.SiteSetting;
    string siteName = setting != null ? setting.NameFa : "آموزش مجازی کیش";
    string siteTel = setting != null ? setting.tel : "076-44444444";
    string siteAddress = setting != null ? setting.Address : "جزیره کیش";
    string siteEmail = setting != null ? setting.EmailInfo : "info@kishlearning.com";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewBag.Title != null ? ViewBag.Title + " - " : "")@siteName</title>
    <meta name="description" content="@ViewBag.Description" />
    <meta name="keywords" content="@ViewBag.Keywords" />
    <link rel="shortcut icon" href="@Url.Content("~/images/logo.png")" />

    <!-- استایل محلی Tailwind -->
    <link href="@Url.Content("~/Content/tailwind.min.css")" rel="stylesheet" />

    <!-- فونت‌آیکون‌ها و استایل‌های محلی پروژه -->
    <link href="@Url.Content("~/kishlearning724/css/font-awesome.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/audioplayer.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/site-layout.css")" rel="stylesheet" />

    @RenderSection("styles", required: false)
</head>

<body class="bg-gray-50 text-gray-800 antialiased flex flex-col min-h-screen">

    <!-- نوار اعلان و اطلاعات تماس بالای هدر -->
    <div class="bg-brand-900 text-white text-xs py-2 px-4">
        <div class="container mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">

            <!-- تماس: موبایل مخفی؛ در عرض 640px به بالا نمایش داده می‌شود -->
            <div class="header-contact-info">
                <span>
                    <i class="fa fa-phone ml-1 text-brand-400" aria-hidden="true"></i>
                    تلفن: @siteTel
                </span>

                <span>
                    <i class="fa fa-envelope ml-1 text-brand-400" aria-hidden="true"></i>
                    ایمیل: @siteEmail
                </span>
            </div>

            <div class="w-full sm:w-auto flex items-center justify-end sm:justify-start gap-3 whitespace-nowrap">
                <a href="@Url.Action("AllActiveSurvey", "Home")"
                   class="hover:text-brand-300 transition">نظرسنجی‌ها</a>

                <span aria-hidden="true" class="text-brand-700">|</span>

                <a href="@Url.Action("JoinUs", "Home")"
                   class="hover:text-brand-300 transition">مدرس شوید</a>
            </div>

        </div>
    </div>





    <!-- هدر اصلی و منو -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-4 h-20 flex items-center justify-between gap-3">

            <div class="flex items-center gap-8 min-w-0">
                <a href="/" class="flex items-center gap-3 flex-shrink-0">
                    <img src="@Url.Content("~/Content/images/logo.png")"
                         alt="@siteName"
                         class="h-12 w-auto object-contain"
                         onerror="this.src='@Url.Content("~/images/logo.png")'" />
                </a>

                <!-- منوی دسکتاپ -->
                <nav class="desktop-nav hidden md:flex items-center gap-6 text-sm font-medium text-gray-600"
                     aria-label="منوی اصلی">
                    <a href="/" class="hover:text-brand-600 transition">صفحه اصلی</a>
                    <a href="@Url.Action("ShowAllClasses", "Home")" class="hover:text-brand-600 transition">دوره‌ها و کلاس‌ها</a>
                    <a href="@Url.Action("AllActiveAzmoon", "Home")" class="hover:text-brand-600 transition">آزمون‌ها</a>
                    <a href="@Url.Action("Index", "Books")" class="hover:text-brand-600 transition">کتابخانه</a>
                    <a href="@Url.Action("Podcast", "Home")" class="hover:text-brand-600 transition">پادکست</a>
                    <a href="@Url.Action("Teacher", "Home")" class="hover:text-brand-600 transition">اساتید</a>
                </nav>
            </div>

            <div class="flex items-center gap-3 flex-shrink-0">
                <!-- ابزارهای هدر دسکتاپ -->
                <div class="desktop-header-actions hidden md:flex items-center gap-4">
                    <a href="@Url.Action("Index", "Books")"
                       class="hidden lg:flex items-center gap-2 text-gray-500 hover:text-brand-600 bg-gray-100 px-3 py-2 rounded-lg text-sm transition">
                        <i class="fa fa-search" aria-hidden="true"></i>
                        <span>جستجو در سایت...</span>
                    </a>

                    @Html.Partial("_LoginPartial")
                </div>

                <!-- دکمه منوی موبایل -->
                <button type="button"
                        id="mobileMenuBtn"
                        class="mobile-menu-toggle"
                        aria-label="باز کردن منو"
                        aria-controls="mobileNav"
                        aria-expanded="false"
                        title="منوی سایت">
                    <i id="mobileMenuIcon" class="fa fa-bars" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <!-- منوی بازشونده موبایل -->
        <nav id="mobileNav"
             class="mobile-nav"
             aria-label="منوی اصلی موبایل"
             hidden>

            <div class="mobile-nav-links">
                <a href="/" class="mobile-nav-link">صفحه اصلی</a>
                <a href="@Url.Action("ShowAllClasses", "Home")" class="mobile-nav-link">دوره‌ها و کلاس‌ها</a>
                <a href="@Url.Action("AllActiveAzmoon", "Home")" class="mobile-nav-link">آزمون‌ها</a>
                <a href="@Url.Action("Index", "Books")" class="mobile-nav-link">کتابخانه</a>
                <a href="@Url.Action("Podcast", "Home")" class="mobile-nav-link">پادکست</a>
                <a href="@Url.Action("Teacher", "Home")" class="mobile-nav-link">اساتید</a>
                <a href="@Url.Action("AllActiveSurvey", "Home")" class="mobile-nav-link">نظرسنجی‌ها</a>
                <a href="@Url.Action("JoinUs", "Home")" class="mobile-nav-link">مدرس شوید</a>
            </div>

            <a href="@Url.Action("Index", "Books")" class="mobile-search-link">
                <i class="fa fa-search" aria-hidden="true"></i>
                <span>جستجو در سایت...</span>
            </a>

            <!-- نسخه موبایل دکمه‌های ورود و ثبت‌نام یا پنل کاربر -->
            <div class="mobile-auth">
                @Html.Partial("_LoginPartial")
            </div>
        </nav>
    </header>

    <!-- محتوای صفحات -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- فوتر سایت -->
    <footer class="bg-gray-900 text-gray-300 pt-16 pb-8 border-t border-gray-800">
        <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">

            <div class="space-y-4">
                <h3 class="text-white text-lg font-heading">درباره @siteName</h3>
                <p class="text-sm text-gray-400 leading-relaxed " style="margin:0">
                    مرجع تخصصی آموزش مجازی، برگزاری دوره‌های آنلاین، آزمون‌های استاندارد و صدور گواهینامه‌های معتبر در جزیره کیش و سراسر کشور. تأسیس ۱۳۹۴.
                </p>
            </div>

            <div class="space-y-4">
                <h3 class="text-white text-lg font-heading">دسترسی سریع</h3>
                <ul class="space-y-2 text-sm  text-gray-400">
                    <li><a href="@Url.Action("joinUs", "Home")" class="hover:text-white transition">به ما بپیوندید</a></li>
                    <li><a href="/Home/Details/9" class="hover:text-white transition">تاریخچه</a></li>
                    <li><a href="@Url.Action("ContactUs", "UserComment")" class="hover:text-white transition">ثبت نظرات</a></li>
                    <li><a href="@Url.Action("Index", "Support")" class="hover:text-white transition">سوالات متداول</a></li>
                </ul>
            </div>

            <div class="space-y-4">
                <h3 class="text-white text-lg font-heading">ارتباط با ما</h3>
                <ul class="space-y-2 text-sm text-gray-400">
                    <li><i class="fa fa-map-marker ml-2 text-brand-500" aria-hidden="true"></i>@siteAddress</li>
                    <li><i class="fa fa-phone ml-2 text-brand-500" aria-hidden="true"></i>@siteTel</li>
                    <li><i class="fa fa-envelope ml-2 text-brand-500" aria-hidden="true"></i>@siteEmail</li>
                </ul>
            </div>

            <div class="space-y-4">
                <h3 class="text-white text-lg font-heading">مجوزها و نمادها</h3>

                <div class="enamad-card">
                    <a referrerpolicy="origin"
                       target="_blank"
                       rel="noopener noreferrer"
                       href="https://trustseal.enamad.ir/?id=624676&Code=0zEBXyAJcUXJv6uQGSaqeyjXMXHo7axh"
                       aria-label="مشاهده نماد اعتماد الکترونیکی">
                        <img referrerpolicy="origin"
                             src='https://trustseal.enamad.ir/logo.aspx?id=624676&Code=0zEBXyAJcUXJv6uQGSaqeyjXMXHo7axh'
                             alt="نماد اعتماد الکترونیکی"
                             width="70"
                             height="70"
                             loading="lazy"
                             style='cursor:pointer' 
                             code='0zEBXyAJcUXJv6uQGSaqeyjXMXHo7axh' />
                        <span>نماد اعتماد الکترونیکی</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="container mx-auto px-4 pt-8 border-t border-gray-800 text-center text-xs text-gray-500 font-traffic">
            کلیه حقوق این وب‌سایت متعلق به @siteName می‌باشد. (1394 - 1405)
        </div>
    </footer>

    <!-- اسکریپت‌های محلی سیستم -->
    <script src="@Url.Content("~/kishlearning724/js/jquery.min.js")"></script>

    <script>
        if (typeof jQuery !== 'undefined') {
            jQuery.fn.megaMenu = jQuery.fn.megaMenu || function () {
                return this;
            };
        }
    </script>

    <!-- کنترل منوی موبایل -->
    <script>
        (function () {
            var menuButton = document.getElementById('mobileMenuBtn');
            var mobileNav = document.getElementById('mobileNav');
            var menuIcon = document.getElementById('mobileMenuIcon');

            if (!menuButton || !mobileNav || !menuIcon) {
                return;
            }

            function closeMobileMenu() {
                mobileNav.hidden = true;
                menuButton.setAttribute('aria-expanded', 'false');
                menuButton.setAttribute('aria-label', 'باز کردن منو');
                menuIcon.classList.remove('fa-times');
                menuIcon.classList.add('fa-bars');
            }

            function openMobileMenu() {
                mobileNav.hidden = false;
                menuButton.setAttribute('aria-expanded', 'true');
                menuButton.setAttribute('aria-label', 'بستن منو');
                menuIcon.classList.remove('fa-bars');
                menuIcon.classList.add('fa-times');
            }
            closeMobileMenu();

            menuButton.addEventListener('click', function () {
                var isExpanded = menuButton.getAttribute('aria-expanded') === 'true';

                if (isExpanded) {
                    closeMobileMenu();
                } else {
                    openMobileMenu();
                }
            });

            mobileNav.querySelectorAll('a').forEach(function (link) {
                link.addEventListener('click', closeMobileMenu);
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeMobileMenu();
                }
            });

            window.addEventListener('resize', function () {
                if (window.innerWidth >= 768) {
                    closeMobileMenu();
                }
            });
        })();

        function countPreviewItemByClient(objType, objId) {
            //debugger;
            console.log(objType);
            var url = '/Home/ObjCount';
            $.ajax({
                url: url,
                data: { ObjType: objType, ObjId: objId },
                type: 'post',
                async: true
                //success: function (res) {

                //}
            });
        }
    </script>

    @RenderSection("scripts", required: false)
    @Html.Partial("~/Views/Shared/SweetAlert.cshtml")
</body>
</html>
