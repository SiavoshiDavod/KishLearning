@model IEnumerable<SenakLearn.Models.StudentSupport>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    SiteSetting.SiteSetting setting = (SiteSetting.SiteSetting)ViewBag.SiteSetting;
}

<h2>ویدئوهای آموزشی دانشجویان</h2>
<div class="row">
    <div style="vertical-align: top;" class="col-xs-12 col-sm-12 col-md-4">
        <a href="#" class="btn btn-info">تلفن های پشتیبانی<br /> @setting.tel @setting.Mobile</a>
        <ul class="course-accordion">
            @{
                string open = " opened";
                int count = 0;
                foreach (var item in Model.Where(x => x.ParentId == null).OrderBy(x=>x.Order))
                {
                    <li class="accordion-option @open">
                        @{ open = ""; count++;
                            var childs = Model.Where(c => c.ParentId == item.Id).OrderBy(x => x.Order);
                        }
                        <div class="option-title" onclick="return ShowVideoStudentSupport(@item.Id);"> #@count: @item.Description <span></span></div>
                        <div class="option-wrapper">
                            <ul class="option-items">
                                
                                    @foreach (var Subitem in childs)
                                    {
                                        <li class="option-item">
                                            <div class="pull-right"> @*<span class="duration">@Subitem.</span>*@<a href="#"><i class="zmdi zmdi-star"></i></a> </div>
                                            <a  onclick="return ShowVideoStudentSupport(@Subitem.Id);">@Subitem.Description</a>
                                        </li>
                                    }

                            </ul>
                        </div>
                    </li>
                            }
            }

        </ul>

        </div>
    <div id="OnlineClassDetailsDiv" style="vertical-align: top;" class="col-xs-12 col-sm-12 col-md-8">
        @Html.Partial("~/Views/Shared/_PartialVideo.cshtml",setting.DefaultVideoUrl)
    </div>
</div>
<script type="text/javascript">
                        function ShowVideoStudentSupport(id) {
                            $.ajax(
                                {
                                    type: 'Get',
                                    //data: { Code:  },
                                    url: '/Support/ShowVideo?id=' + id,
                                    success: function (result) {
                                        $('#OnlineClassDetailsDiv').html(result);
                                    },
                                    error: function (error) {
                                        alert(error.toString());
                                    }
                                });
                            return false;
                        }
</script>