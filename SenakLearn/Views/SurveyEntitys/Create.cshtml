                    <span class="glyphicon glyphicon-calendar"></span>
                </div>
                <input type="text" class="form-control" id="FromDate_l" name="FromDate_l" value="@Model.FromDate_l" placeholder="تاریخ شروع" />
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ToDate_l, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="input-group   col-md-10">

                <div class="input-group-addon" data-mddatetimepicker="true" data-targetselector="#ToDate_l" data-trigger="click" data-enabletimepicker="true">
                    <span class="glyphicon glyphicon-calendar"></span>
                </div>
                <input type="text" class="form-control" id="ToDate_l" name="ToDate_l"  value="@Model.ToDate_l" placeholder="تاریخ پایان" />
            </div>
        </div>
        <!--<div class="form-group">-->
        @*@Html.LabelFor(model => model.ToDate, htmlAttributes: new { @class = "control-label col-md-2", @style = "cursor:pointer" })*@
        <!--<label class="control-label col-md-2" for="ToDate" style="cursor:pointer">
            <img src="~/images/64x64/document.png" width="16" height="16" />
            تاریخ پایان

        </label>
        <div class="col-md-10">-->
        @*@Html.EditorFor(model => model.ToDate, new { htmlAttributes = new { @class = "form-control" } })*@
        <!--<input type="text" id="ToDate-1" class="form-control" placeholder="تاریخ را انتخاب نمایید" aria-label="ToDate-1"
               aria-describedby="ToDate-1">
        <input type="text" id="ToDate" name="ToDate" class="form-control" placeholder="Persian Calendar Date"
               aria-label="ToDate" aria-describedby="ToDate" style="visibility:hidden" value="">-->
        @*@Html.ValidationMessageFor(model => model.ToDate, "", new { @class = "text-danger" })*@
        <!--</div>
        </div>-->

        <div class="form-group">
            @Html.LabelFor(model => model.IsIpRestriction, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.IsIpRestriction, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.IsIpRestriction, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.IsShowInSinglePage, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.IsShowInSinglePage, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.IsShowInSinglePage, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.IsUserMustBeLogin, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.IsUserMustBeLogin, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.IsUserMustBeLogin, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.Status, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.IsFavorite, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.IsFavorite, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.IsFavorite, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.IsImportant, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.IsImportant, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.IsImportant, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.IsPrivate, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.IsPrivate, new { htmlAttributes = new { @class = "form-control", @onchange = "return isPrivateChange();" } })
                    @Html.ValidationMessageFor(model => model.IsPrivate, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group IsPrivateChange">
            @Html.LabelFor(model => model.SurveyPrivateGroupId, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.SurveyPrivateGroupDropDown("SurveyPrivateGroupId", false)
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="button" class="btn btn-default" onclick="formSubmit(event)">ذخیره</button>
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("بازگشت", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function isPrivateChange() {
            if ($("#IsPrivate").is(':checked')) {
                $(".IsPrivateChange").show();
            } else {
                $("#SurveyPrivateGroupId").val('');
                $(".IsPrivateChange").hide();
            }
            return false;
        }
        function formSubmit(ev) {
            ev.preventDefault();
            //alert('243');
            //debugger;
            console.log($('#FromDate-1').val());
            console.log($('#FromDate').val());

            $('#frmCreateSurveyEntitys').submit();
        }
        $(document).ready(function () {
            isPrivateChange();
            $('#FromDate').MdPersianDateTimePicker({
                targetTextSelector: '#FromDate-1',
                targetDateSelector: '#FromDate',
                dateFormat: 'yyyy-MM-dd hh:mm:ss',
                isGregorian: false,
                enableTimePicker: true,
                disableBeforeToday: true,

            });
            $('#ToDate').MdPersianDateTimePicker({
                targetTextSelector: '#ToDate-1',
                targetDateSelector: '#ToDate',
                dateFormat: 'yyyy-MM-dd hh:mm:ss',
                isGregorian: false,
                enableTimePicker: true,
                disableBeforeToday: true,

            });

        });
        $("#IsPrivate").on("change", isPrivateChange);
    </script>
}
