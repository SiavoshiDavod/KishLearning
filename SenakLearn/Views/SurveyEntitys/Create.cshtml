@model SenakLearn.Models.SurveyEntity

@{
    ViewBag.Title = "پرسشنامه";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">ذخیره سازی</a></li>
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">ذخیره سازی @ViewBag.Title </h4>
        </div>
    </div>
</div>
@using (Html.BeginForm("Create", "SurveyEntitys", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmCreateSurveyEntitys" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.AnswerCount)
        @Html.HiddenFor(model => model.QuestionCount)

        <div class="form-group">
            @Html.LabelFor(model => model.GroupSurveyId, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.GroupSurveyDropDown("GroupSurveyId", true)
                @Html.ValidationMessageFor(model => model.GroupSurveyId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.SurveyImageUrl, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <label class="btn btn-default"> انتخاب فایل عکس  <input @*accept=".pdf, .doc , .docx"  accept="video/*"*@ accept="image/*" class="fileChosen" type="file" hidden id="File" name="File"></label><span class="fileChosenText">
                    @if (Model != null && !string.IsNullOrEmpty(Model.SurveyImageUrl))
                    {
                        <a href="~/images/Survey/@Model.SurveyImageUrl"><img src="~/images/Survey/@Model.SurveyImageUrl" title="دانلود" height="50" /></a>
                    }
                </span>
                @Html.HiddenFor(x => x.SurveyImageUrl)
                @Html.ValidationMessageFor(model => model.SurveyImageUrl, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.FromDate_l, htmlAttributes: new { @class = "control-label col-md-2" })
            @*<label class="control-label col-md-2" for="FromDate" style="cursor:pointer">
                    <img src="~/images/64x64/document.png" width="16" height="16" />
                    تاریخ شروع

                </label>*@
            <div class="input-group   col-md-10">
                @*@Html.EditorFor(model => model.FromDate, new { htmlAttributes = new { @class = "form-control", @name = "data-MdPersianDateTimePicker" } })*@
                @*<div class="input-group-prepend">
                        <span class="input-group-text cursor-pointer" id="date1">Icon</span>
                    </div>*@
                @*<input type="text" id="FromDate-1" class="form-control" placeholder="تاریخ را انتخاب نمایید" aria-label="FromDate-1"
                           aria-describedby="FromDate-1">
                    <input type="text" id="FromDate" name="FromDate" class="form-control" placeholder="Persian Calendar Date"
                           aria-label="FromDate" aria-describedby="FromDate" style="visibility:hidden" value="@Model.FromDate">*@

                @*@Html.ValidationMessageFor(model => model.FromDate, "", new { @class = "text-danger" })*@
