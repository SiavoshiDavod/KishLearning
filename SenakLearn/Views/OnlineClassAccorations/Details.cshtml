@model SenakLearn.Models.OnlineClassAccoration

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>@Html.DisplayFor(model => model.Name)</h2>
<div class="row">
    <div style="vertical-align: top;" class="col-xs-12 col-sm-12 col-md-4">
        <div id="TadGroupGoodsTreeDiv">



            <fieldset>
                @using MVC.Controls
                <div id="OnlineClassTree" style="width: 20%; height: 100%" class="span-3">
                </div>
                @(Html.TreeView1(new List<SenakLearn.Models.OnlineClassAccorationDetails>(), "OnlineClassTree", "Id")
          .EmptyContent("هیچ موردی یافت نشد.")
          .IsAjax()
          .OpenAll(true)
          .ShowContextMenu(true)
          .showContextCreate(true, "createOnlineClassTreeChild")
          .showContextEdit(true, "editOnlineClassTree")
          .showContextRemove(true, "deleteOnlineClassTree")
          .SetSearchable(true)
          .Sortable(false)
          //.ShowCheckbox(ViewBag.SelectedIds != null)
          .LanguageDirection("rtl")
          .AjaxUrl("/OnlineClassAccorations/GetTreeList?id=" + Model.Id, true))

                    <script type="text/javascript">
                        function createOnlineClassTreeChild(obj, id) {
                            $.ajax(
                                {
                                    type: 'Get',
                                    //data: { Code:  },
                                    url: '/OnlineClassAccorationDetails/Create?id=' +
                                    (obj != null ? obj.id : id),
                                    success: function (result) {
                                        $('#OnlineClassTree').jstree("refresh");
                                        $('#OnlineClassDetailsDiv').html(result);
                                    },
                                    error: function (error) {
                                        alert(error.toString());
                                    }
                                });
                            return false;
                        }

                        function editOnlineClassTree(obj, id) {
                            $.ajax(
                                {
                                    type: 'Get',
                                    //data: { Code:  },
                                    url: '/OnlineClassAccorationDetails/Edit?id=' + (obj != null ? obj.id : id),
                                    success: function (result) {
                                        $('#OnlineClassTree').jstree("refresh");
                                        $('#OnlineClassDetailsDiv').html(result);
                                    },
                                    error: function (error) {
                                        alert(error.toString());
                                    }
                                });
                            return false;
                        }

                        function deleteOnlineClassTree(obj) {
                            var deleted = function () {
                                $.post('/OnlineClassAccorationDetails/Delete?id=' + obj.id,
                                     function (data) {
                                         $('#OnlineClassTree').jstree("refresh");
                                         //$("#OnlineClassFormId").reset();
                                         //  $("#NewBtn").trigger("click");
                                     });
                            }
                            confirmDelete(deleted);
                        }
                        function deleted() {

                            //$('#SubUnitTbl').hide();
                        }

                        $("#OnlineClassTree").delegate("a",
                            "click",
                            function (e) {
                                editOnlineClassTree(null, $(this).parent().attr('id'));
                                //$("#OnlineClassTree").jstree("open_node", $(this).parent());

                                //$("#OnlineClassTree").jstree("select_node", $(this).parent());
                                ////load process sequence
                                //loadOnlineClassByCode($(this).parent().attr('id'));

                                //lastCode = $(this).parent().attr('id');
                            });

                        $('#myForm').submit(function (e) {
                            
                            e.preventDefault();
                            var url = $(this).closest('form').attr('action'),
                     data = $(this).closest('form').serialize();
                            $.ajax({
                                url: url,
                                type: 'post',
                                data: data,
                                success: function () {
                                    $('#OnlineClassTree').jstree("refresh");
                                }
                            });
                        });
                    </script>

            </fieldset>
        </div>
    </div>
    <div id="OnlineClassDetailsDiv" style="vertical-align: top;" class="col-xs-12 col-sm-12 col-md-8">
        @Html.Partial("~/Views/OnlineClassAccorationDetails/Create.cshtml", new SenakLearn.Models.OnlineClassAccorationDetails() { OnlineClassAccorationId = Model.Id });
    </div>
</div>