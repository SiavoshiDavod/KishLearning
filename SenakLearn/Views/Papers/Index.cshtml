
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/papers/LoadList";
    ViewBag.Title = "مقالات";
}
<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>
        </div>
    </div>
</div>  
<div id="TadGoodsField">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("papersesGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList).
        SetCaption("مقالات").
    SetOnLoadCompleteEvent("loadpapersesGridCompleteEvent").
        UseColumns(SenakLearn.Controllers.Admin.PapersController.Columns)
)
    <script type="text/javascript">
	function loadpapersesGridCompleteEvent() {
		var ids = $("#papersesGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
			var cl = ids[i];
			ed = '<a class="ajaxLink"  href="/papers/Create?Id=' + cl + '" title="ویرایش"><div class="tableEditLink">ویرایش</div></a>';
			dl = '<a class="ajaxLink delete"href="/papers/Delete?Id=' + cl + '" title="حذف"   ><div class="tableDeleteLink">حذف</div></a>';
			de = '<a class="ajaxLink "href="/papers/Details?Id=' + cl + '" title="جزئیات"   ><div class="tableDeleteLink">جزئیات</div></a>';
			$('#papersesGrid').jqGrid('setRowData', ids[i], { act: ed + dl + de });
		}
    }

    </script>
</div>



