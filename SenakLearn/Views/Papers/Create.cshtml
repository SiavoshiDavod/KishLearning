@model SenakLearn.Models.Paper

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "مقالات";
}
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="card-box">

            @using (Html.BeginForm("Create", "Papers", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {

                <div class="form-horizontal">
                    <hr />
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.Id)
                    @Html.HiddenFor(model => model.CreatedDate)
                    <div class="form-group">
                        @Html.LabelFor(model => model.GroupId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.Cours_Group_DropDown("GroupId", true, new { @class = "jquery-select" }, "یک دسته را انتخاب کنید", null, null, null,true)
                            @Html.ValidationMessageFor(model => model.GroupId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.FieldId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.PaperFieldDropDown("FieldId", true)
                            @Html.ValidationMessageFor(model => model.FieldId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.TrendIds, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.PaperTrendDropDown("TrendArr", true)
                            @Html.ValidationMessageFor(model => model.TrendIds, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.PublisherId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.PaperPublisherDropDown("PublisherId", true)

                            @Html.ValidationMessageFor(model => model.PublisherId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.JournalId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.PaperJournalDropDown("JournalId", true)
                            @Html.ValidationMessageFor(model => model.JournalId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.TitleF, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.TitleF, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.TitleF, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.PageCount, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.PageCount, new { htmlAttributes = new { @class = "form-control ", @Style = " max-width: 80px;" } })
                            @Html.ValidationMessageFor(model => model.PageCount, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Year, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control ", @Style = " max-width: 80px;" } })
                            @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Keyword, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Keyword, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Keyword, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.UniversityId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.PaperUniversityDropDown("UniversityId", true)

                            @Html.ValidationMessageFor(model => model.UniversityId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.HasReference, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.HasReference)
                                @Html.ValidationMessageFor(model => model.HasReference, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.HasTranslate, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.HasTranslate)
                                @Html.ValidationMessageFor(model => model.HasTranslate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.PageCountF, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.PageCountF, new { htmlAttributes = new { @class = "form-control", @Style = " max-width: 80px;" } })
                            @Html.ValidationMessageFor(model => model.PageCountF, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.IsTranslateImageTableTitle, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.IsTranslateImageTableTitle)
                                @Html.ValidationMessageFor(model => model.IsTranslateImageTableTitle, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.IsTranslateImage, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.IsTranslateImage)
                                @Html.ValidationMessageFor(model => model.IsTranslateImage, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.IsTranslateTable, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.IsTranslateTable)
                                @Html.ValidationMessageFor(model => model.IsTranslateTable, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.IsImagesInTranslate, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.IsImagesInTranslate)
                                @Html.ValidationMessageFor(model => model.IsImagesInTranslate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.IsTablesInTranslate, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.IsTablesInTranslate)
                                @Html.ValidationMessageFor(model => model.IsTablesInTranslate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.IsFormulaInTranslate, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.IsFormulaInTranslate)
                                @Html.ValidationMessageFor(model => model.IsFormulaInTranslate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.IsReferenceInTranslate, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox ">
                                @Html.EditorFor(model => model.IsReferenceInTranslate, new { htmlAttributes = new { @class = "checkbox checkbox-info checkbox-circle" } })
                                @Html.ValidationMessageFor(model => model.IsReferenceInTranslate, "", new { @class = "text-danger " })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.TranslateQualityId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">

                            @Html.PaperTranslateQualityDropDown("TranslateQualityId", true)
                            @Html.ValidationMessageFor(model => model.TranslateQualityId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Indicator, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Indicator, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Indicator, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Abstract, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Abstract, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Abstract, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.AbstractF, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.AbstractF, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.AbstractF, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Price, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control", @Style = " max-width: 200px;" } })
                            @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.FileId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <label class="btn btn-default"> انتخاب فایل اصلی  <input accept=".pdf, .doc , .docx" class="fileChosen" type="file" hidden id="File" name="File"></label><span class="fileChosenText">
                                @if (Model != null && !string.IsNullOrEmpty(Model.FileId))
                                {
                                    <a href="~/images/Paper/@Model.FileId">دانلود</a>
                                }
                            </span>
                            @Html.HiddenFor(x => x.FileId)
                            @Html.ValidationMessageFor(model => model.FileId, "", new { @class = "text-danger" })

                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.ScreenShotId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <label class="btn btn-default"> انتخاب عکس  <input accept="image/*" class="fileChosen0" type="file" hidden id="ScreenShot" name="ScreenShot"></label><span class="fileChosenText0">
                                @if (Model != null && !string.IsNullOrEmpty(Model.ScreenShotId))
                                {
                                    <a href="~/images/Paper/@Model.ScreenShotId">دانلود</a>
                                }
                            </span>
                            @Html.HiddenFor(x => x.ScreenShotId)
                            @Html.ValidationMessageFor(model => model.ScreenShotId, "", new { @class = "text-danger" })

                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.TranslateWordId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <label class="btn btn-default"> انتخاب فایل ترجمه ورد  <input accept=".doc ,.docx" class="fileChosen1" type="file" hidden id="TranslateWord" name="TranslateWord"></label><span class="fileChosenText1">
                                @if (Model != null && !string.IsNullOrEmpty(Model.TranslateWordId))
                                {
                                    <a href="~/images/Paper/@Model.TranslateWordId">دانلود</a>
                                }
                            </span>
                            @Html.HiddenFor(x => x.TranslateWordId)
                            @Html.ValidationMessageFor(model => model.TranslateWordId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.TranslatePdfId, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <label class="btn btn-default"> انتخاب فایل ترجمه پی دی اف  <input  accept=".pdf" class="fileChosen2" type="file" hidden id="TranslatePdf" name="TranslatePdf"></label><span class="fileChosenText2">
                                @if (Model != null && !string.IsNullOrEmpty(Model.TranslatePdfId))
                                {
                                    <a href="~/images/Paper/@Model.TranslatePdfId">دانلود</a>
                                }
                            </span>
                            @Html.HiddenFor(x => x.TranslatePdfId)
                            @Html.ValidationMessageFor(model => model.TranslatePdfId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" value="ثبت" class="btn btn-default" />
                        </div>
                    </div>
                </div>
            }

            <div>
                @Html.ActionLink("بازگشت", "Index")
            </div>
            @section Scripts {
                @Scripts.Render("~/bundles/jqueryval")
     
               <script src="/ckeditor/ckeditor.js"></script>
                <script src="/ckeditor/adapters/jquery.js"></script>
                <script>
                    $(function () {
                        $('#Abstract').ckeditor();
                        $('#AbstractF').ckeditor();
                        $('#Indicator').ckeditor();

                    });
                    $(".fileChosen0").change(function () {
                        filename = this.files[0].name;
                        $(".fileChosenText0").html(filename);
                    });
                    $(".fileChosen1").change(function () {
                        filename = this.files[0].name;
                        $(".fileChosenText1").html(filename);
                    });
                    $(".fileChosen2").change(function () {
                        filename = this.files[0].name;
                        $(".fileChosenText2").html(filename);
                    });
                </script>
            }

        </div>
    </div>
</div>
