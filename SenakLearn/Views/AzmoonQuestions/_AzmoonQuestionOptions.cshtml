@model SenakLearn.Models.AzmoonQuestion
@{
    Layout = null;
}
    <div>
        @{
            if (Model.AzmoonQuestionOptions?.Count > 0)
            {
                foreach (var item in Model.AzmoonQuestionOptions)
                {

                    <a onclick="return RemoveOptions('@Model.Id','@item.Id','@Model.AzmoonEntityId')" style="cursor: pointer;" title="حذف">حذف</a> 
                    <input class="btn btn-danger" style="margin:10px" value="@item.QuestionOption" />
                    if (Model.QuestionType.ToString().Contains("Image"))
                    {
                        <img src="~/images/QuestionOption/@item.QuestionOptionUrl" height="50" />
                        <a onclick="return UpdateImageOptions('@Model.Id','@Model.AzmoonEntityId','@item.Id','@item.QuestionOption','@item.Width','@item.Height')" style="cursor: pointer;" title="ویرایش">ویرایش</a>
                    }
                    if (item.IsCorrect)
                    {
                        <span class="fa fa-check"></span>
                        <a onclick="return SetCorrect('@Model.Id','@item.Id','@Model.AzmoonEntityId',false)" style="cursor: pointer;" title="لغو صحیح بودن گزینه">لغو صحیح بودن گزینه</a> <br />
                    }
                    else
                    {
                        <span class="fa fa-close"></span>
                        <a onclick="return SetCorrect('@Model.Id','@item.Id','@Model.AzmoonEntityId',true)" style="cursor: pointer;" title="انتخاب به عنوان گزینه صحیح">صحیح بودن گزینه</a> <br />
                    }
                }
            }
            if (Model?.Id > 0)
            {
                if (Model.QuestionType.ToString().Contains("Image"))
                {
                    <label class="btn btn-default"> افزودن عکس به لیست <input onchange="return AddImageOptions('@Model.Id','@Model.AzmoonEntityId',this,event)" accept="image/*" class="fileChosen" type="file" hidden @*id="File" name="File"*@></label><span class="fileChosenText"> </span>
                }
                else
                {
                    <button class="btn btn-primary" onclick="return AddOptions('@Model.Id','@Model.AzmoonEntityId')" title="افزودن موارد لیست">افزودن موارد لیست</button>
                }
            }
        }

    </div>

<script>
    function AddOptions(id, AzmoonEntityId) {
        //e.preventDefault();
        Swal.fire({
            title: 'افزودن موارد لیست',
            input: 'text',
            inputAttributes: {
                autocapitalize: 'off'
            },
            showCancelButton: false,
            confirmButtonText: 'ثبت',
            showLoaderOnConfirm: false,

            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.value) {

                pw.post("/AzmoonQuestionOptions/Create?AzmoonQuestionId=" + id + "&QuestionOption=" + result.value,
               { AzmoonQuestionId: id, QuestionOption: result.value },
               'json',
               function (response) {
                   window.location.href = '/AzmoonQuestions/Create?AzmoonEntityId=' + AzmoonEntityId + '&Id=' + id;
                   SwalSuccessMessage("");
               });
                return false;
            }
        })
        return false;
    }
    function SetCorrect(id, model, AzmoonEntityId, iscorrect) {
         var url = "/AzmoonQuestionOptions/SetCorrect";
       // var successFunction = function () {
            pw.post(url,
                { id: model, iscorrect: iscorrect },
                'json',
                function (response) {
                    if (response) {
                        window.location.href = '/AzmoonQuestions/Create?AzmoonEntityId=' + AzmoonEntityId + '&Id=' + id;
                        SwalSuccessMessage("");
                    } else {
                        showError("خطا");
                    }
                   
                });

        //}
        //confirmDelete(successFunction)
        return;
    }
    function RemoveOptions(id, model, AzmoonEntityId) {
        var url = "/AzmoonQuestionOptions/Delete";
        var successFunction = function () {
            pw.post(url,
                { id: model },
                'json',
                function (response) {
                    if (response) {
                        window.location.href = '/AzmoonQuestions/Create?AzmoonEntityId=' + AzmoonEntityId + '&Id=' + id;
                        SwalSuccessMessage("");
                    } else {
                        showError("خطا");
                    }
                   
                });

        }
        confirmDelete(successFunction)
        return;
    }

    function AddImageOptions(id, AzmoonEntityId, value, event) {
        if (value == null || value.files == null || value.files[0] == null) {
            return false;
        }
        var fdata = new FormData();
        var file = value.files[0];
       
        fdata.append("file", file);
        pw.openLoading();
        $.ajax({
            type: 'post',
            url: "/AzmoonQuestionOptions/CreateImage?AzmoonQuestionId=" + id ,//+ "&QuestionOption=",
            data: fdata,
            processData: false,
            contentType: false
        }).done(function (response) {
            pw.closeLoading();
            
            if (response) {
                window.location.href = '/AzmoonQuestions/Create?AzmoonEntityId=' + AzmoonEntityId + '&Id=' + id;
                SwalSuccessMessage("");
            } else {
                showError("انتخاب فایل الزامی است");
            }
           
        });
        return false;
    }
    function UpdateImageOptions(id, AzmoonEntityId, model, desc, wid, hei) {
        swal({
            title: 'ویرایش ویژگی های عکس',
            showCancelButton: false,
            confirmButtonText: 'ثبت',
            showLoaderOnConfirm: false,

            allowOutsideClick: () => !Swal.isLoading(),
            html:
              '<span>متن عکس<span><input id="swal-input1" class="swal2-input" ' + desc + '>' +
              '<span>عرض <span><input type="number" id="swal-input2" class="swal2-input" ' + wid + '>' +
              '<br><span>ارتفاع <span><input type="number" id="swal-input3" class="swal2-input" ' + hei + '>',
            preConfirm: function () {
                return new Promise(function (resolve) {
                    resolve([
                      $('#swal-input1').val(),
                      $('#swal-input2').val(),
                      $('#swal-input3').val()
                    ])
                })
            },
            onOpen: function () {
                $('#swal-input1').focus()
            }
        }).then(function (result) {
            
            if (result.value[0] != '' && result.value[1] != '' && result.value[2] != '') {

                pw.post("/AzmoonQuestionOptions/UpdatImage?AzmoonQuestionOptionId=" + model + "&QuestionOption=" + result.value[0] + "&width=" + result.value[1] + "&height=" + result.value[2],
               { AzmoonQuestionOptionId: model, QuestionOption: result.value[0] },
               'json',
               function (response) {
                   if (response) {
                       window.location.href = '/AzmoonQuestions/Create?AzmoonEntityId=' + AzmoonEntityId + '&Id=' + id;
                       SwalSuccessMessage("");
                   } else {
                       showError("خطا");
                   }
                   
               });
                return false;
            }
            showError("لطفا همه فیلدها را پر کنید");
            return false;
        }).catch(swal.noop)
        return false;
       
    }
</script>

