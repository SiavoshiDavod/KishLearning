}

<div>
    @Html.ActionLink("بازگشت", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    function isPrivateChange() {
        if ($("#IsPrivate").is(':checked')) {
            $(".IsPrivateChange").show();
        }else {
            $("#AzmoonPrivateGroupId").val('');
            $(".IsPrivateChange").hide();
        }
        return false;
    }
    $(document).ready(function () {
        isPrivateChange();
        $('#FromDate').MdPersianDateTimePicker({
            targetTextSelector: '#FromDate-1',
            targetDateSelector: '#FromDate',
            dateFormat: 'yyyy-MM-dd hh:mm:ss',
            width:'120',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: true,

        });
        $('#ToDate').MdPersianDateTimePicker({
            targetTextSelector: '#ToDate-1',
            targetDateSelector: '#ToDate',
            dateFormat: 'yyyy-MM-dd hh:mm:ss',
            isGregorian: false,
            enableTimePicker: true,
            disableBeforeToday: true,

        });

        $(".fileChosen").change(function () {
            filename = this.files[0].name;
            $(".fileChosenText").html(filename);
        });
        $(".fileChosen2").change(function () {
            filename = this.files[0].name;
            $(".fileChosenText2").html(filename);
        });
    });
    $("#IsPrivate").on("change", isPrivateChange);
    </script>
}
