        <div class="col-md-10">
            <div class="checkbox">
                @Html.EnumDropDownListFor(model => model.AzmoonEntityType, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.AzmoonEntityType, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.TimeDuration, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
