<div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm space-y-6">
    <h3 class="font-titr text-lg text-gray-900 border-b border-gray-100 pb-3">جستجو و فیلتر کتابخانه</h3>

    <div class="space-y-4 text-sm">
        <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">عنوان کتاب</label>
            <input type="text" id="BookTitle" placeholder="بخشی از عنوان..." class="w-full border border-gray-200 rounded-xl px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
        </div>

        <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">انتشارات</label>
            @Html.PaperPublisherDropDown("BookPublisher", false, false, new { @class = "w-full border border-gray-200 rounded-xl px-3 py-2 text-sm" }, "همه ناشران")
        </div>

        <div>
            <button onclick="reloadBooks()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-xl transition text-sm">
                اعمال فیلتر کتاب‌ها
            </button>
        </div>
    </div>
</div>

