
<div class="search-something">
    <input type="search" id="BookTitle" placeholder="دنبال چه چیزی هستید؟">
    <a onclick="reloadBooks()"><i class="zmdi zmdi-search"></i></a>
</div>
<div id="course-single">
    <div class="categories">
        <h6>موضوع ها</h6>
        <ul>
            @{
                var categorieslist = SenakLearn.Biz.CourseBiz.Instance.FindAllGroup(null, null,null,true,null);
                foreach (var item in categorieslist)
                {
                    <li><a onclick="reloadBooks('@item.id')">@item.name (@item.BookCount)</a></li>
                }
            }
        </ul>
    </div>

</div>
<div>
    @Html.PaperPublisherDropDown("BookPublisher", false, false, new { style = "width:270px" }, "همه ناشرها")

</div>
