@using SenakLearn.Models.Common
@using SenakLearn.Models
@model Pagination<Book>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "کتابخانه و مقالات علمی";
    int countPage = Model != null ? Model.CountPage : 0;
    int currentPage = Model != null ? Model.CurrentPage : 1;
}
<style>
    /* تنظیم رنگ متن در حالت عادی */
    .btn-view-book {
        display: block;
        width: 100%;
        padding: 8px 0;
        background: #eff6ff; /* blue-50 */
        color: #2563eb; /* blue-600 */
        text-align: center;
        border-radius: 8px;
        font-weight: 700;
        transition: all 0.3s ease;
        text-decoration: none !important;
    }

        /* تنظیم رنگ متن و پس‌زمینه در حالت هاور */
        .btn-view-book:hover {
            background: #2563eb; /* blue-600 */
            color: #ffffff !important; /* اینجا متن حتما سفید می‌شود */
        }

</style>
<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
        <!-- Title & Filter bar -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-titr text-gray-900">کتابخانه و بانک کتب آموزشی</h1>
                <p class="text-sm text-gray-500 mt-1">مطالعه و دانلود آخرین کتب تخصصی، هندبوک‌ها و جزوات آزمون</p>
            </div>
        </div>

        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-8 grid grid-cols-1 md:grid-cols-3 gap-4">
            <input type="text" id="book_keyword" value="@ViewBag.keyword" placeholder="جستجوی عنوان کتاب یا نویسنده..." class="border border-gray-200 rounded-xl px-4 py-2 text-sm" />
            <input type="text" id="book_author" value="@ViewBag.Author" placeholder="نام نویسنده..." class="border border-gray-200 rounded-xl px-4 py-2 text-sm" />
            <button onclick="ReloadBooks()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl py-2 text-sm transition">جستجو</button>
        </div>

        <!-- Books Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6">
            @if (Model != null && Model.DataPage != null && Model.DataPage.Any())
            {
                foreach (var item in Model.DataPage)
                {
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-lg transition flex flex-col justify-between p-3 text-center">
                        <div>
                            <div class="aspect-[3/4] bg-gray-100 rounded-xl overflow-hidden mb-3 shadow-inner">
                                <img src="@(!string.IsNullOrEmpty(item.ScreenShotId) ? "/images/book/" + item.ScreenShotId : "/images/book/default-book.png")" alt="@item.TitleF" class="w-full h-full object-cover" onerror="this.src='/assets/img/preview.jpg'" />
                            </div>
                            <h3 class="font-titr text-xs text-gray-900 line-clamp-2 mb-1">@item.TitleF</h3>
                            <p class="text-[11px] text-gray-400 line-clamp-1">@item.Title</p>
                        </div>
                        <div class="pt-3 border-t border-gray-50 mt-2">
                            <a onclick='return countPreviewItemByClient("@SenakLearn.Models.ObjCount.objType_Book", @item.Id)' href="/Books/detail?Id=@item.Id" class="btn-view-book">
                                مشاهده کتاب
                            </a>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Pagination -->
        @if (countPage > 1)
        {
            <div class="mt-12 flex justify-center gap-2">
                @for (int i = 1; i <= countPage; i++)
                {
                    <a href="?page=@i&keyword=@ViewBag.keyword&author=@ViewBag.Author" class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-bold border @(i == currentPage ? "bg-blue-600 text-white border-blue-600" : "bg-white text-gray-700 border-gray-200 hover:bg-gray-100") transition">
                        @i
                    </a>
                }
            </div>
        }
    </div>
</section>

@section scripts {
    <script>
        function ReloadBooks() {
            var k = $("#book_keyword").val() || "";
            var a = $("#book_author").val() || "";
            window.location.href = "/Books/Index?keyword=" + encodeURIComponent(k) + "&author=" + encodeURIComponent(a);
        }
    </script>
}

