
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/TeacherVideoFile/LoadList";
    ViewBag.Title = "فایل ویدیویی";
}
<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>
        </div>
    </div>
</div>

<div id="TadGoodsField">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("OnlineClassesGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList).
        SetCaption("فایل ویدیویی").
    SetOnLoadCompleteEvent("loadOnlineClassesGridCompleteEvent").
        UseColumns(SenakLearn.Controllers.Admin.VideoFileController.Columns)
)
    <script type="text/javascript">
	function loadOnlineClassesGridCompleteEvent() {
		var ids = $("#OnlineClassesGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
			var cl = ids[i];
			ed = '<a class="ajaxLink"  href="/TeacherVideoFile/Edit?Id=' + cl + '" title="ویرایش"><div class="tableEditLink">ویرایش</div></a>';
			dl = '<a class="ajaxLink delete"href="/TeacherVideoFile/Delete?Id=' + cl + '" title="حذف"   ><div class="tableDeleteLink">حذف</div></a>';
			de = '<a class="ajaxLink "href="/TeacherVideoFile/Details?Id=' + cl + '" title="نمایش "   ><div class="tableDeleteLink">نمایش</div></a>';
			$('#OnlineClassesGrid').jqGrid('setRowData', ids[i], { act: ed + dl + de  });
		}
    }

    </script>
</div>



