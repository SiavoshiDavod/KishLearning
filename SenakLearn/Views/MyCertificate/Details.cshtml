
@model SenakLearn.Models.Person.Person_Certificate
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "مدرک صادر شده";
}
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("بازگشت", "Index", "MyCertificate") </h4>
        </div>
    </div>
</div>
@using (Html.BeginForm())
{
    @Html.HiddenFor(model => model.Id)
    @Html.AntiForgeryToken()
<div class="form-horizontal">
    <div class="form-group">
        <div class="col-md-2 text-left">
            @Html.LabelFor(model => model.CourseName, htmlAttributes: new { @class = "control-label" })
        </div>
        <div class="col-md-4">
            @Html.EditorFor(model => model.CourseName, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
        </div>
