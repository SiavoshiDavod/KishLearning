
@model SenakLearn.Models.TeacherSupport

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "اساتید";
}
<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            @*<h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>*@
        </div>
    </div>
</div>

<div class="row">
    <div style="vertical-align: top;" class="col-xs-12 col-sm-12 col-md-4">
        <div id="TadGroupGoodsTreeDiv">



            <fieldset>
                @using MVC.Controls
                <div id="TeacherSupport" style="width: 20%; height: 100%" class="span-3">
                </div>
                @(Html.TreeView1(new List<SenakLearn.Models.TeacherSupport>(), "TeacherSupport", "Id")
          .EmptyContent("هیچ موردی یافت نشد.")
          .IsAjax()
          .OpenAll(true)
          .ShowContextMenu(true)
          .showContextCreate(true, "createTeacherSupportChild")
          .showContextEdit(true, "editTeacherSupport")
          .showContextRemove(true, "deleteTeacherSupport")
          .SetSearchable(true)
          .Sortable(false)
          //.ShowCheckbox(ViewBag.SelectedIds != null)
          .LanguageDirection("rtl")
          .AjaxUrl("/TeacherSupport/GetTreeList?id=0", true))

                <script type="text/javascript">
                        function createTeacherSupportChild(obj, id) {
                            $.ajax(
                                {
                                    type: 'Get',
                                    //data: { Code:  },
                                    url: '/TeacherSupport/Create?id=' +
                                    (obj != null ? obj.id : id),
                                    success: function (result) {
                                        $('#TeacherSupport').jstree("refresh");
                                        $('#OnlineClassDetailsDiv').html(result);
                                    },
                                    error: function (error) {
                                        alert(error.toString());
                                    }
                                });
                            return false;
                        }

                        function editTeacherSupport(obj, id) {
                            $.ajax(
                                {
                                    type: 'Get',
                                    //data: { Code:  },
                                    url: '/TeacherSupport/Edit?id=' + (obj != null ? obj.id : id),
                                    success: function (result) {
                                        $('#TeacherSupport').jstree("refresh");
                                        $('#OnlineClassDetailsDiv').html(result);
                                    },
                                    error: function (error) {
                                        alert(error.toString());
                                    }
                                });
                            return false;
                        }

                        function deleteTeacherSupport(obj) {
                            var deleted = function () {
                                $.post('/TeacherSupport/Delete?id=' + obj.id,
                                     function (data) {
                                         $('#TeacherSupport').jstree("refresh");
                                         //$("#OnlineClassFormId").reset();
                                         //  $("#NewBtn").trigger("click");
                                     });
                            }
                            confirmDelete(deleted);
                        }
                        function deleted() {

                            //$('#SubUnitTbl').hide();
                        }

                        $("#TeacherSupport").delegate("a",
                            "click",
                            function (e) {
                                editTeacherSupport(null, $(this).parent().attr('id'));
                                //$("#TeacherSupport").jstree("open_node", $(this).parent());

                                //$("#TeacherSupport").jstree("select_node", $(this).parent());
                                ////load process sequence
                                //loadOnlineClassByCode($(this).parent().attr('id'));

                                //lastCode = $(this).parent().attr('id');
                            });

                        $('#myForm').submit(function (e) {
                            
                            e.preventDefault();
                            var url = $(this).closest('form').attr('action'),
                     data = $(this).closest('form').serialize();
                            $.ajax({
                                url: url,
                                type: 'post',
                                data: data,
                                success: function () {
                                    $('#TeacherSupport').jstree("refresh");
                                }
                            });
                        });
                </script>

            </fieldset>
        </div>
    </div>
    <div id="OnlineClassDetailsDiv" style="vertical-align: top;" class="col-xs-12 col-sm-12 col-md-8">
        @Html.Partial("~/Views/TeacherSupport/Create.cshtml", new SenakLearn.Models.TeacherSupport());
    </div>
</div>