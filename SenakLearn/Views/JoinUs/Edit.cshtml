@model SenakLearn.Models.JoinUs
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@using (Html.BeginForm())
{
    @Html.HiddenFor(model => model.UserId)
    @Html.HiddenFor(model => model.TeacherId)
    @Html.HiddenFor(model => model.IsAccept)
    @Html.HiddenFor(model => model.AcceptedDate)
    @Html.HiddenFor(model => model.CreatedDate)
    <div class="form-horizontal container">
        <h3>همکاری با ما</h3>
        <hr />
        @Html.Partial("~/Views/Shared/_ProgressBarCircleForSteps.cshtml",Model)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group form-groupRtl">
            @Html.LabelFor(model => model.Name, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group form-groupRtl">
            @Html.LabelFor(model => model.Family, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Family, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Family, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group form-groupRtl">
            @Html.LabelFor(model => model.NationalCode, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NationalCode, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.NationalCode, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group form-groupRtl">
            @Html.LabelFor(model => model.Email, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Email, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group form-groupRtl">
            @Html.LabelFor(model => model.Mobile, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Mobile, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Mobile, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group form-groupRtl">
            @Html.LabelFor(model => model.Description, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.Description, new
           {
               @class = "form-control",
               @cols = 80,
               @rows = 10
           })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group form-groupRtl">
            @Html.LabelFor(model => model.ResumeFile, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.HiddenFor(model => model.ResumeFile)
                @if (!string.IsNullOrEmpty(Model.ResumeFile))
                {
                    <a href='/images/joinUs/@Model.ResumeFile'>دانلود</a>
                }
                @Html.ValidationMessageFor(model => model.ResumeFile, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group form-groupRtl">
            @Html.LabelFor(model => model.GroupIds, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.Cours_Group_DropDown("GroupIds", true, new { @class = "jquery-select" })
                @Html.ValidationMessageFor(model => model.GroupIds, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="ثبت اطلاعات" class="btn btn-default" />
                <input type="button" onclick="return Mypost('/JoinUs/Accept?id=@Model.Id')" value="تایید مجدد و ارسال ایمیل و پیامک" class="btn btn-default" />
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}



<script src='/Scripts/Learn.js' type='text/javascript'></script>

