@model IEnumerable<SenakLearn.Models.Security.AzmoonPrivateGroup>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/AzmoonPrivateGroups/LoadList";
    ViewBag.Title = "گروه اختصاصی آزمون";
    var user = (SenakLearn.Models.learn_user)ViewBag.User;
}
<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>
        </div>
    </div>
</div>
<div id="TadGoodsField">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("AzmoonPrivateGroupGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetListUrl(urlList).
        SetCaption("گروه اختصاصی آزمون").
    SetOnLoadCompleteEvent("loadAzmoonPrivateGroupGridCompleteEvent").
        UseColumns(SenakLearn.Controllers.AzmoonPrivateGroupsController.AzmoonPrivateGroupColumns)
)
    <script type="text/javascript">
	function loadAzmoonPrivateGroupGridCompleteEvent() {
		var ids = $("#AzmoonPrivateGroupGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
			var cl = ids[i];
			ed = '<a class="ajaxLink"  href="/AzmoonPrivateGroups/Create?Id=' + cl + '" title="ویرایش"><div class="fa fa-pencil"></div></a>';
			dl = '<a class="ajaxLink delete"href="/AzmoonPrivateGroups/Delete?Id=' + cl + '" title="حذف"   ><div class="fa fa-times"></div></a>';
			de = '<a class="ajaxLink "href="/AzmoonPrivateGroups/Details?Id=' + cl + '" title="جزئیات"   ><div class="fa fa-building"></div></a>';
			var role = '';
            @if (user.Permisstions.Any(x => x == SenakLearn.Models.Security.Permisstion.AzmoonPrivateGroupUsers)){
			    @: role = '<a class="ajaxLink "href="/AzmoonPrivateGroupUsers/Index?Id=' + cl + '" title="کاربران"   ><div class="fa fa-calendar"></div></a>';
			}

			$('#AzmoonPrivateGroupGrid').jqGrid('setRowData', ids[i], { act: ed + dl + de + role });
		}
    }

    </script>
</div>




