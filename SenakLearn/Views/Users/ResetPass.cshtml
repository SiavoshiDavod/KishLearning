<section class="login-form page-section-ptb">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("ResetPass", "Users", FormMethod.Post, new { @class = "gray-form mt-2 clearfix",@onsubmit= "return validateForm()" }))
                {
                    @Html.Partial("_PartialGoogleRecapcha", "ResetPass")
                    <div class="form-group">
                        @Html.Label("ایمیل خود را وارد کنید ")
                        @Html.Editor("email", "", new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    <div class="form-group">
                        <input type="submit" value="بازیابی کلمه عبور" class="button" />
                    </div>

                }
            </div>
            </div>
        </div>
    </section>
<script>
    function validateForm() {
        return checkCaptcha();
    }
</script>
