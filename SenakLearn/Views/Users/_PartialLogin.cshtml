@model SenakLearn.Models.LoginViewModel
@using (Html.BeginForm("Login", "Users",FormMethod.Post, new { @class = "gray-form mt-2 clearfix", @onsubmit = "return validateForm()" }))
{
    @Html.Hidden("ReturnUrl", (string)ViewBag.returl)
    @Html.Partial("_PartialGoogleRecapcha", "login")
    <div class="form-group">
        <label for="name">نام کاربری*</label>
        @Html.EditorFor(model => model.userNameLogin, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.userNameLogin, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        <label for="Password">رمز عبور*</label>
        @Html.EditorFor(model => model.Pass, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Pass, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.EditorFor(model => model.Remember)
        @Html.LabelFor(model => model.Remember, new { @class = "" })
        @Html.ValidationMessageFor(model => model.Remember, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        <div class="remember-checkbox mb-3">
            @*<input type="checkbox" name="one" id="one">*@
            @*<label for="one">پذیرش <a href="#"> سیاست ها</a> و <a href="#"> مقررات</a> سایت ما</label>*@
            @Html.ActionLink("کلمه عبور را فراموش کردم", "ResetPass", "Users", new { @*@class = "pull-left"*@ })
        </div>
    </div>
    <div class="form-group">
        <input type="submit" value="ورود" class="button" />
    </div>
    <script>
    function validateForm() {
        return checkCaptcha();
    }
    </script>
}

