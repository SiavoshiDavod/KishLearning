@model SenakLearn.Models.RegisterViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "عضویت در آموزش مجازی کیش";
}

<section class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-xl w-full bg-white p-8 sm:p-10 rounded-3xl shadow-xl border border-gray-100 space-y-6">
        <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 mb-3">
                <i class="fa fa-user-plus text-2xl"></i>
            </div>
            <h2 class="text-2xl font-titr text-gray-900">ایجاد حساب کاربری جدید</h2>
            <p class="text-sm text-gray-500 mt-1">به جمع دانشجویان و متخصصان بپیوندید</p>
        </div>

        @Html.Partial("_PartialRegister")

        <div class="text-center pt-4 border-t border-gray-100 text-sm text-gray-600">
            قبلاً ثبت‌نام کرده‌اید؟
            <a href="/Users/Login" class="text-blue-600 hover:text-blue-700 font-bold mr-1">ورود به سیستم</a>
        </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

