@model SenakLearn.Models.VideoFile

@{
    Layout = null;
}
<style>
    video {
        display: none;
    }

    textarea {
        width: 100%;
    }

    input[type=text] {
        width: 100%;
    }
</style>

@using (Html.BeginForm("Create", "VideoFile", FormMethod.Post, new { enctype = "multipart/form-data", id = "formVideoFileUploadPartial" }))
{
    <input type="hidden" id="fileUploadedId" />
    <input type="hidden" id="fileUploadedName" />

    <div class="form-horizontal">
        <h4> ایجاد</h4>
        <hr />
        @Html.ValidationSummary(true)
        <div class="form-group">
            @Html.LabelFor(model => model.titel, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.titel, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.titel)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.doc, new { @class = "control-label col-md-2" })
            <div class="col-md-10 full">
                @Html.EditorFor(model => model.doc, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.doc)
            </div>
        </div>

        @*<div class="form-group">
                @Html.LabelFor(model => model.myFile,  new { @class = "control-label col-md-2" })
                <div class="col-md-8">
                    <label class="btn btn-default"> انتخاب ویدیو  <input accept="video/*" class="fileChosen" type="file" hidden id="ImageFile" name="ImageFile"></label><span class="fileChosenText"></span>
                    @Html.ValidationMessageFor(model => model.myFile)
                </div>
            </div>*@
        <div class="form-group">
            <input type="file" accept="video/mp4, audio/mp3" id="fileUploadForVideo" />
            <video controls id="showFileUploadForVideo" width="400" height="270">
                <source type="video/mp4 ">
            </video>
            @*<canvas></canvas>
                <br />
                <img id="imgFileUploadForVideo"/>*@
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-3 pull-left">
                @*<input type="button" value="ثبت" onclick="btnCreateVideoFile()" class="btn btn-success" />*@
                <button class="form-control btn btn btn-success" >ثبت</button>
            </div>
        </div>
    </div>
}

<script>
    $(function () {
        var video = $($("#showFileUploadForVideo")[0]);
        //var thumbnail = $("canvas");
        var input = $($('#fileUploadForVideo')[0]);
        //debugger;
        //var ctx = thumbnail.get(0).getContext("2d");
        //var duration = 0;
        //var img = $($("#imgFileUploadForVideo")[0]);

        input.on("change", function (e) {
            var file = e.target.files[0];
            // Validate video file type
            if (["video/mp4"].indexOf(file.type) === -1 ) {
                //alert("Only 'MP4/mp3' video format allowed.");
                //return;
                // Set video source
                video.find("source").attr("src", URL.createObjectURL(file));
                // Load the video
                video.get(0).load();
                // Load metadata of the video to get video duration and dimensions
                video.show();
            //video.get(0).play();
            }

        });
    });


    $('#formVideoFileUploadPartial').submit(function (e) {
        e.preventDefault(); // stop the standard form submission
        //debugger;
        LockMainForLoading();
        var fileUpload = $("#fileUploadForVideo").get(0);
        var files = fileUpload.files[0];
        if (files == undefined)
            return;
        var formData = new FormData();
        formData.append('videoUpload', files);
        formData.append('titel', $('#titel').val());
        formData.append('doc', $('#doc').val());
        $.ajax({
            url: '/VideoFile/CreateAjax',
            type: 'POST',
            data: formData,
            cache: false,
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.VideoId != undefined) {
                    console.log(data.UploadedFileId + ' file uploaded successfully');
                    //debugger;
                    $('#fileUploadedId').val(data.VideoId);
                    $('#fileUploadedName').val(data.VideoName);
                    $(".dialogVideoUploadClass").dialog('close');;
                }
                unLockMainForLoading();
            },
            error: function (xhr, error, status) {
                console.log(error, status);
                unLockMainForLoading();
            }
        });
    });

</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
