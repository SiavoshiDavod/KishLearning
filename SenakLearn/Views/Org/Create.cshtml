@model SenakLearn.Models.Organization


@{
    ViewBag.Title = SenakLearn.Models.Dictionary.ModelDictionary[typeof(SenakLearn.Models.Organization)];
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">ذخیره سازی</a></li>
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">ذخیره سازی @ViewBag.Title </h4>
        </div>
    </div>
</div>



@using (Html.BeginForm())
{   
    @Html.HiddenFor(model => model.Id)
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        <div class="col-md-2 text-right">
            @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label" })
            <span class="fa fa-question-circle" title="نام نقش" style="color:blue"></span>
        </div>
        <div class="col-md-10">
            @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-2 text-right">
            @Html.LabelFor(model => model.Descript, htmlAttributes: new { @class = "control-label" })
            <span class="fa fa-question-circle" title="توضیحات " style="color:blue"></span>
        </div>
        <div class="col-md-10">
            @Html.EditorFor(model => model.Descript, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Descript, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="ثبت" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
     @Html.ActionLink("بازگشت", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
