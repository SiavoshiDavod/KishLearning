        <dt>
            @Html.DisplayNameFor(model => model.image)
        </dt>

        <dd>
            @if (Model.image != null)
            {
                <img src="/images/cours/@Model.image" alt=@Model.name class="thumbnail" />
            }
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Resume)
        </dt>

        <dd>
            @Html.Raw(Model.Resume)
        </dd>
       
    </dl>
