    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>@ViewBag.Title</h2>

<div>
    <hr />
    <dl class="table table-responsive">
        <dt>
            @Html.DisplayNameFor(model => model.name)
