@model IEnumerable<SenakLearn.Models.learn_teacher>

@{
     ViewBag.Title = SenakLearn.Models.Dictionary.ModelDictionary[typeof(SenakLearn.Models.learn_teacher)];
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var urlList = "/Teacher/LoadList";
}
<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>
        </div>
    </div>
</div>
<div id="TadGoodsField">
    @using MVC.Controls

    @Html.Grid(
    new GridControl().SetName("TeachereesGrid").
    SetPageSize(10).
    SetShrinkToFit(false).
    SetIsAutoSize(true).
    SetIsFilterToolbar(true).
    IsRTL().
    SetSortName("id").
    SetListUrl(urlList).
        SetCaption("اساتید").
    SetOnLoadCompleteEvent("loadTeachereesGridCompleteEvent").
        UseColumns(SenakLearn.Controllers.Admin.TeacherController.TeacherColumns)
)
    <script type="text/javascript">
	function loadTeachereesGridCompleteEvent() {
		var ids = $("#TeachereesGrid").jqGrid('getDataIDs');
		for (var i = 0; i < ids.length; i++) {
			var cl = ids[i];
			ed = '<a class="ajaxLink"  href="/Teacher/edit?Id=' + cl + '" title="ویرایش"><div class="tableEditLink">ویرایش</div></a>';
			dl = '<a class="ajaxLink delete"href="/Teacher/Delete?Id=' + cl + '" title="حذف"   ><div class="tableDeleteLink">حذف</div></a>';
			$('#TeachereesGrid').jqGrid('setRowData', ids[i], { Resume: ed + dl  });
		}
    }

    </script>
</div>



