<script src='/Scripts/Learn.js' type='text/javascript'></script>
<script src="/ckeditor/ckeditor.js"></script>
<script src="/ckeditor/adapters/jquery.js"></script>
<script>
    $(function () {
        $('#body').ckeditor();
    });
    function sendEmail() {
        var action = "/sendSms/SendEmail";
        var body=$('#body').val();
        var subject=$('#subject').val();
        var email = $('#email').val();
        var GroupId = $('#Groupemail').val();
        var GroupOr = $('#GroupOrEmail').val();
        if (GroupOr == "True") {
            Mypost(action, { body: body, subject: subject, To: email });
            reloadJqGrid('EmailSmsGrid');
        } else {
            Mypost(action + "Batch", { body: body, subject: subject, GroupId: GroupId });
        }
       
    }
    function sendsms() {
        var action = "/sendSms/SendSms";
        var mobile = $('#mobile').val();
        var GroupOr = $('#GroupOrMobile').val();
        var GroupId = $('#Groupmobile').val();
        var content = $('#content').val();
        if (GroupOr == "True") {
            Mypost(action, { mobile: mobile, content: content });
            reloadJqGrid('EmailSmsGrid');
        } else {
            Mypost(action + "Batch", { content: content, GroupId: GroupId });
        }
       
    }
    $("#GroupOrEmail").change(function () {
        GroupOrEmailChange(this.value);
    });
    $("#GroupOrMobile").change(function () {
        GroupOrMobileChange(this.value);
    });
    $(document).ready(function () {
        GroupOrEmailChange($("#GroupOrEmail").val());
        GroupOrMobileChange($("#GroupOrMobile").val());
    });
    function GroupOrEmailChange(val) {
        if (val == "True") {
            $("#emailDiv").show();
            $("#GroupemailDiv").hide();
        } else {
            $("#GroupemailDiv").show();
            $("#emailDiv").hide();
        }
    }

    function GroupOrMobileChange(val) {
        if (val == "True") {
            $("#mobileDiv").show();
            $("#GroupmobileDiv").hide();
        } else {
            $("#GroupmobileDiv").show();
            $("#mobileDiv").hide();
        }
    }
</script>