@model IEnumerable<SenakLearn.Models.OnlineClassRequest>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "لیست درخواست کلاس های آنلاین";
}

<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            @*<h4 class="page-title">@Html.ActionLink("افزودن", "Create") </h4>*@
        </div>
    </div>
</div>    
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.UserId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.OnlineClassId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Notices)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UpdateDate)
        </th>
        @*<th></th>*@
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>@if (item.learn_user != null)
        {
            @Html.DisplayFor(modelItem => item.learn_user.user_name)
        }

        </td>
        <td>@if (item.OnlineClass != null)
        {
            @Html.DisplayFor(modelItem => item.OnlineClass.name)
        }
          
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Notices)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CreatedDateShamsi)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.UpdateDateShamsi)
        </td>
        @*<td>
            @Html.ActionLink("ویرایش", "Edit", new { id=item.Id }) |
            @Html.ActionLink("جزییات", "Details", new { id=item.Id }) |
            @Html.ActionLink("حذف", "Delete", new { id=item.Id })
        </td>*@
    </tr>
}

</table>
