@model SenakLearn.Models.DynamicForm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.Title;
}
<div id="course-single" class="page">
    <div class="page-heading text-center">
        <div class="container">
            <h2>@Html.DisplayFor(model => model.Title)</h2>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                @{
                    var filePrevivew = SiteSetting.GetSetting.Instance.Get().DefaultVideoUrl;
                    if (Model.InterviewPathVideo != null && Model.InterviewPathVideo != Guid.Empty)
                    {
                        filePrevivew = "/images/VideoFile/" + Model.InterviewPathVideo.ToString().Replace("-", "") + ".mp4";
                        <div class="resp-img">
                            @Html.Partial("~/Views/Shared/_PartialVideo.cshtml", filePrevivew);
                        </div>
                    }
                }
                
                @if (!string.IsNullOrEmpty(Model.Image))
            {
                    <img src="~/images/DynamicForm/@Model.Image" title="@Model.Title" alt="@Model.Title" class="resp-img" />
                }
                else
                {
                    <img src="/assets/img/preview.jpg" alt="blog-single" class="resp-img">
                }
                <h3>@Html.DisplayFor(model => model.Title)  </h3>
                <div>
                    @Html.Raw(Model.Content)
                </div>
