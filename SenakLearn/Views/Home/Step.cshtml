                    </div>*@
                <h4 class="comment">نظرات</h4>

                @Html.Action("ShowComments", "UserComment", new { id = Model.Id, type = SenakLearn.Models.PageType.Step6 })

                <h4 class="comment">ارسال دیدگاه</h4>
                @Html.Action("ContactUs", "UserComment", new { id = Model.Id, type = SenakLearn.Models.PageType.Step6 })


            </div>
            <div class="col-lg-3 blog-sidebar">
                <div class="search-something">
                    <input type="search" placeholder="دنبال چه چیزی هستید؟">
                    <a href="#"><i class="zmdi zmdi-search"></i></a>
                </div>
                <h4>پست های اخیر</h4>
                <div class="recent-post clearfix">
                    <img src="/assets/img/recent1.jpg" alt="recent" class="pull-left"> <a href="#">آموزش روتوش چهره در فتوشاپ</a>
                    <div class="author"> <a href="#">فتوشاپ</a><span>18 فروردین 1395</span> </div>
                </div>
                <div class="categories">
                    <h6>دسته بندی ها</h6>
                    <ul>
                        @{
                            var categorieslist = SenakLearn.Biz.CourseBiz.Instance.FindAllGroup(null, null, null, null, null);
                            foreach (var item in categorieslist)
                            {
                                <li><a href="#">@item.name (@item.SumCount)</a></li>
                            }
                        }

                    </ul>

                </div>
                <div class="popular-courses index-3-categories">
                    <h4>محبوب ترین دوره های آنلاین</h4>
                    <div class="courses-side-slick">
                        @{
                            var onlineClass = SenakLearn.Biz.OnlineClassBiz.Instance.GetAllPage(x => x.IsFavorite && x.ClassType != SenakLearn.Enums.OnlineClassType.Archived, 0, 3);
                            foreach (var item in onlineClass)
                            {
                                var img = "/images/Interview/" + item.InterviewPathImage;
                                if (string.IsNullOrEmpty(item.InterviewPathImage))
                                {
                                    img = "/images/logo.png";
                                }
                                <div class="category-with-bg text-center " style=" background-image:url(@img); ">
                                    <div style="opacity:0.5;background-color: #ffffff;">
                                        <h5 style="font-weight: bold;color: #000000;">@item.name</h5>
                                        <p style="font-weight: bold;color: #000000;">@item.Description</p>
                                        <a style="font-weight: bold;color: #000000;" href="/DetailsOnlineClass/Index?type=2&id=@item.Id" class="goto">
                                            <i class="zmdi zmdi-long-arrow-right"></i>
                                        </a>
                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>
                <div class="popular-courses index-3-categories">
                    <h4>محبوب ترین فیلم های آموزشی</h4>
                    <div class="courses-side-slick">
                        @{
                            var listCourse = SenakLearn.Biz.CourseBiz.Instance.FindAll(x => x.status && x.IsFavorite, 3);
                            foreach (var item in listCourse)
                            {
                                var img = "/images/cours/" + item.image;
                                if (string.IsNullOrEmpty(item.image))
                                {
                                    img = "/images/logo.png";
                                }
                                <div class="category-with-bg text-center " style=" background-image:url(@img); ">
                                    <div style="opacity:0.5;background-color: #ffffff;">
                                        <h5 style="font-weight: bold;color: #000000;">@item.name</h5>
                                        <p style="font-weight: bold;color: #000000;">@item.doc</p>
                                        <a style="font-weight: bold;color: #000000;" href="/DetailsCours/Index?type=1&id=@item.id" class="goto">
                                            <i class="zmdi zmdi-long-arrow-right"></i>
                                        </a>
                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>
