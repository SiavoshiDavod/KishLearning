@model IEnumerable<SenakLearn.Models.learn_teacher>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "اساتید و مدرسان";
}

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
        <!-- Header -->
        <div class="text-center max-w-2xl mx-auto mb-10">
            <h1 class="text-3xl font-titr text-gray-900 mb-2">اساتید و هیئت علمی</h1>
            <p class="text-gray-500 text-sm">با اساتید مجرب و باسابقه آموزش مجازی کیش آشنا شوید</p>
        </div>

        <!-- Filter Bar -->
        <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-gray-100 mb-10">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-center">
                <div>
                    @Html.Cours_Group_DropDown("CoursGroupId", false, new { @class = "w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" }, "انتخاب دسته‌بندی...", (int?)ViewBag.groupId, null, true)
                </div>
                <div>
                    @Html.Teacher_DropDown("TeacherId", false, new { @class = "w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" }, "انتخاب استاد...", (int?)ViewBag.teacherId)
                </div>
                <div>
                    <input type="text" id="keywords" name="keywords" value="@ViewBag.keyword" placeholder="نام استاد یا تخصص..." class="w-full border border-gray-200 rounded-xl px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                </div>
                <div>
                    <button type="button" onclick="searchTeachers()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-xl transition flex items-center justify-center gap-2 text-sm">
                        <i class="fa fa-search"></i> جستجوی مدرسین
                    </button>
                </div>
            </div>
        </div>

        <!-- Teachers Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="bg-white rounded-2xl border border-gray-100 p-6 text-center shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="w-28 h-28 mx-auto rounded-full overflow-hidden border-4 border-blue-50 shadow-inner mb-4">
                                <img src="@(!string.IsNullOrEmpty(item.image) ? "/images/teacher/" + item.image : "/assets/img/avatar.png")" alt="@item.FullName" class="w-full h-full object-cover" onerror="this.src='/assets/img/avatar.png'" />
                            </div>
                            <h3 class="text-lg font-titr text-gray-900 mb-1">@item.FullName</h3>
                            <p class="text-xs text-blue-600 font-medium mb-3">@item.education</p>
                        </div>
                        <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                            <span class="text-xs text-gray-500"><i class="fa fa-book-open ml-1"></i> @item.CourseCount دوره</span>
                            <a href="/Home/TeacherCours/@item.id" class="text-xs bg-gray-100 hover:bg-blue-600 hover:text-white px-3 py-1.5 rounded-lg transition font-medium">مشاهده دوره‌ها</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full text-center py-12 text-gray-400">
                    <i class="fa fa-user-slash text-4xl mb-3"></i>
                    <p>مدرسی با این مشخصات یافت نشد.</p>
                </div>
            }
        </div>
    </div>
</section>

@section scripts {
    <script>
        function searchTeachers() {
            var g = $("#CoursGroupId").val() || "";
            var t = $("#TeacherId").val() || "";
            var k = $("#keywords").val() || "";
            window.location.href = "/Home/Teacher?groupId=" + encodeURIComponent(g) + "&teacherId=" + encodeURIComponent(t) + "&keyword=" + encodeURIComponent(k);
        }
    </script>
}

