@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "آموزش مجازی کیش - سامانه جامع آموزش و آزمون‌های آنلاین";
    var setting = ViewBag.SiteSetting as SiteSetting.SiteSetting;
    string siteName = setting != null ? setting.NameFa : "آموزش مجازی کیش";
}

<!-- ========================================== -->
<!-- HERO SECTION - MAKTABKHOONEH MODERN STYLE  -->
<!-- ========================================== -->
<div style="background-color: #0f172a; color: #ffffff; padding: 40px 20px; border-bottom: 1px solid #1e293b;">
    <div style="max-width: 1200px; margin: 0 auto;">

        <!-- Main Grid (2 Columns) -->
        <div style="display: flex; flex-wrap: wrap; gap: 40px; align-items: center;">

            <!-- Right Column: Text & Search -->
            <div style="flex: 1; min-width: 300px; text-align: right;">

                <!-- Badge -->
                <div style="display: inline-flex; align-items: center; gap: 8px; background-color: rgba(37, 99, 235, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #60a5fa; padding: 6px 16px; border-radius: 50px; font-size: 13px; font-weight: bold; margin-bottom: 20px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background-color: #3b82f6;"></span>
                    <span>سامانه مرجع آموزش مهارت و آزمون آنلاین کیش</span>
                </div>

                <!-- Main Heading -->
                <h1 style="font-size: 36px; font-weight: 900; line-height: 1.3; margin-bottom: 20px; color: #ffffff;">
                    یادگیری مهارت‌های نوین؛<br />
                    <span style="color: #60a5fa;">مسیری روشن به سمت بازار کار</span>
                </h1>

                <!-- Subtitle -->
                <p style="color: #94a3b8; font-size: 16px; line-height: 1.8; margin-bottom: 25px;">
                    با همراهی اساتید برتر، شرکت در دوره‌های تخصصی پروژه‌محور و دریافت گواهینامه معتبر، آینده شغلی و تحصیلی خود را بسازید.
                </p>

                <!-- Search Box -->
                <div style="max-width: 550px; margin-bottom: 25px;">
                    <form action="/home/ShowAllClasses" method="get" style="display: flex; align-items: center; background-color: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 8px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
                        <i class="fa fa-search" style="color: #94a3b8; font-size: 18px; margin: 0 12px;"></i>
                        <input type="text" name="keyword" placeholder="چه مهارتی می‌خواهید یاد بگیرید؟ (پایتون، ICDL، فتوشاپ...)"
                               style="flex: 1; background: transparent; border: none; color: #ffffff; font-size: 14px; outline: none; padding: 8px;" />
                        <button type="submit" style="background-color: #2563eb; color: #ffffff; border: none; padding: 12px 24px; border-radius: 12px; font-weight: bold; font-size: 14px; cursor: pointer; transition: background 0.2s;">
                            جستجو
                        </button>
                    </form>
                </div>

                <!-- Popular Categories Tags -->
                <div>
                    <div style="font-size: 13px; color: #94a3b8; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                        <i class="fa fa-fire" style="color: #fbbf24;"></i>
                        <span>دسته‌بندی‌های پرطرفدار:</span>
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        <a href="/home/ShowAllClasses?groupName=کامپیوتر" style="background-color: #1e293b; color: #cbd5e1; padding: 6px 14px; border-radius: 8px; font-size: 12px; border: 1px solid #334155; text-decoration: none;">برنامه‌نویسی</a>
                        <a href="/home/ShowAllClasses?keyword=انگیزشی" style="background-color: #1e293b; color: #cbd5e1; padding: 6px 14px; border-radius: 8px; font-size: 12px; border: 1px solid #334155; text-decoration: none;">انگیزشی</a>
                        <a href="/home/ShowAllClasses?keyword=مایکروسافت" style="background-color: #1e293b; color: #cbd5e1; padding: 6px 14px; border-radius: 8px; font-size: 12px; border: 1px solid #334155; text-decoration: none;">مهارت‌های اداری و ICDL</a>
                        <a href="/home/ShowAllClasses?keyword=مدیریت,کسب و کار" style="background-color: #1e293b; color: #cbd5e1; padding: 6px 14px; border-radius: 8px; font-size: 12px; border: 1px solid #334155; text-decoration: none;">حسابداری و بورس</a>
                    </div>
                </div>

            </div>

            <!-- Left Column: Slider Card -->
            <div style="flex: 1; min-width: 300px;">
                <div style="position: relative; width: 100%; height: 420px; border-radius: 24px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7); border: 1px solid #334155; background-color: #000000;">

                    <!-- Slide 1 -->
                    <div class="hero-slide" style="position: absolute; inset: 0; width: 100%; height: 100%; background-image: url('@Url.Content("~/assets/img/slide/slide1.jpg")'); background-size: cover; background-position: center; opacity: 1; z-index: 20; display: flex; flex-direction: column; justify-content: flex-end; padding: 30px; transition: opacity 0.8s ease-in-out;">
                        <div style="position: absolute; inset: 0; background: linear-gradient(to top, #090d16 0%, rgba(15,23,42,0.7) 50%, transparent 100%);"></div>
                        <div style="position: relative; z-index: 10;">
                            <span style="background-color: #2563eb; color: #ffffff; font-size: 12px; padding: 4px 12px; border-radius: 6px; font-weight: bold; display: inline-block; margin-bottom: 10px;">دوره برگزیده</span>
                            <h3 style="font-size: 22px; font-weight: bold; color: #ffffff; margin-bottom: 8px;">آموزش جامع مهارت‌های بازار کار</h3>
                            <p style="font-size: 13px; color: #cbd5e1; margin-bottom: 15px; line-height: 1.5;">یادگیری مهارت‌های عملی با پشتیبانی اختصاصی اساتید و تمرین‌های هفتگی.</p>
                            <a href="/home/ShowAllClasses" style="background-color: #ffffff; color: #0f172a; padding: 8px 18px; border-radius: 10px; font-size: 12px; font-weight: bold; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                مشاهده دوره‌ها <i class="fa fa-arrow-left"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Slide 2 -->
                    <div class="hero-slide" style="position: absolute; inset: 0; width: 100%; height: 100%; background-image: url('@Url.Content("~/assets/img/slide/slide2.jpg")'); background-size: cover; background-position: center; opacity: 0; z-index: 10; display: flex; flex-direction: column; justify-content: flex-end; padding: 30px; transition: opacity 0.8s ease-in-out;">
                        <div style="position: absolute; inset: 0; background: linear-gradient(to top, #090d16 0%, rgba(15,23,42,0.7) 50%, transparent 100%);"></div>
                        <div style="position: relative; z-index: 10;">
                            <span style="background-color: #059669; color: #ffffff; font-size: 12px; padding: 4px 12px; border-radius: 6px; font-weight: bold; display: inline-block; margin-bottom: 10px;">اساتید برتر</span>
                            <h3 style="font-size: 22px; font-weight: bold; color: #ffffff; margin-bottom: 8px;">یادگیری از بهترین متخصصین کشور</h3>
                            <p style="font-size: 13px; color: #cbd5e1; margin-bottom: 15px; line-height: 1.5;">انتقال تجربیات واقعی پروژه‌های صنعتی و سازمانی در جلسات آنلاین.</p>
                            <a href="/home/Teacher" style="background-color: #ffffff; color: #0f172a; padding: 8px 18px; border-radius: 10px; font-size: 12px; font-weight: bold; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                آشنایی با اساتید <i class="fa fa-arrow-left"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Slide 3 -->
                    <div class="hero-slide" style="position: absolute; inset: 0; width: 100%; height: 100%; background-image: url('@Url.Content("~/assets/img/slide/slide3.jpg")'); background-size: cover; background-position: center; opacity: 0; z-index: 10; display: flex; flex-direction: column; justify-content: flex-end; padding: 30px; transition: opacity 0.8s ease-in-out;">
                        <div style="position: absolute; inset: 0; background: linear-gradient(to top, #090d16 0%, rgba(15,23,42,0.7) 50%, transparent 100%);"></div>
                        <div style="position: relative; z-index: 10;">
                            <span style="background-color: #7c3aed; color: #ffffff; font-size: 12px; padding: 4px 12px; border-radius: 6px; font-weight: bold; display: inline-block; margin-bottom: 10px;">مدرک رسمی</span>
                            <h3 style="font-size: 22px; font-weight: bold; color: #ffffff; margin-bottom: 8px;">آزمون‌های آنلاین و گواهینامه معتبر</h3>
                            <p style="font-size: 13px; color: #cbd5e1; margin-bottom: 15px; line-height: 1.5;">سنجش استاندارد دانش، تصحیح خودکار و صدور آنی مدرک قابل استعلام.</p>
                            <a href="/home/OnlineClass" style="background-color: #ffffff; color: #0f172a; padding: 8px 18px; border-radius: 10px; font-size: 12px; font-weight: bold; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                کلاس‌های آنلاین <i class="fa fa-arrow-left"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Navigation Buttons -->
                    <button type="button" onclick="plusHeroSlide(1)" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); z-Index: 30; width: 40px; height: 40px; border-radius: 12px; background: rgba(15,23,42,0.8); color: white; border: 1px solid #334155; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                        <i class="fa fa-chevron-left"></i>
                    </button>
                    <button type="button" onclick="plusHeroSlide(-1)" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); z-Index: 30; width: 40px; height: 40px; border-radius: 12px; background: rgba(15,23,42,0.8); color: white; border: 1px solid #334155; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                        <i class="fa fa-chevron-right"></i>
                    </button>

                    <!-- Indicators -->
                    <div style="position: absolute; top: 15px; left: 15px; z-Index: 30; display: flex; gap: 6px; background: rgba(15,23,42,0.8); padding: 8px 12px; border-radius: 20px; border: 1px solid #334155;">
                        <span onclick="setHeroSlide(1)" class="hero-dot" style="width: 24px; height: 8px; border-radius: 4px; background-color: #3b82f6; cursor: pointer; display: inline-block; transition: all 0.3s;"></span>
                        <span onclick="setHeroSlide(2)" class="hero-dot" style="width: 8px; height: 8px; border-radius: 4px; background-color: rgba(255,255,255,0.4); cursor: pointer; display: inline-block; transition: all 0.3s;"></span>
                        <span onclick="setHeroSlide(3)" class="hero-dot" style="width: 8px; height: 8px; border-radius: 4px; background-color: rgba(255,255,255,0.4); cursor: pointer; display: inline-block; transition: all 0.3s;"></span>
                    </div>

                </div>
            </div>

        </div>

        <!-- Stats Row -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 40px; border-top: 1px solid #1e293b; padding-top: 30px;">

            <div style="display: flex; align-items: center; gap: 15px; background-color: #1e293b; border: 1px solid #334155; padding: 20px; border-radius: 16px;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(37, 99, 235, 0.15); display: flex; align-items: center; justify-content: center; color: #60a5fa; font-size: 20px;">
                    <i class="fa fa-video-camera"></i>
                </div>
                <div>
                    <div style="font-size: 16px; font-weight: bold; color: #ffffff;">+۵۰۰ دوره آموزشی</div>
                    <div style="font-size: 12px; color: #94a3b8;">تخصصی و کاربردی</div>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 15px; background-color: #1e293b; border: 1px solid #334155; padding: 20px; border-radius: 16px;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(5, 150, 105, 0.15); display: flex; align-items: center; justify-content: center; color: #34d399; font-size: 20px;">
                    <i class="fa fa-certificate"></i>
                </div>
                <div>
                    <div style="font-size: 16px; font-weight: bold; color: #ffffff;">گواهینامه معتبر</div>
                    <div style="font-size: 12px; color: #94a3b8;">قابل استعلام آنلاین</div>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 15px; background-color: #1e293b; border: 1px solid #334155; padding: 20px; border-radius: 16px;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; color: #fbbf24; font-size: 20px;">
                    <i class="fa fa-users"></i>
                </div>
                <div>
                    <div style="font-size: 16px; font-weight: bold; color: #ffffff;">+۱۰,۰۰۰ دانش‌پذیر</div>
                    <div style="font-size: 12px; color: #94a3b8;">در سراسر کشور</div>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 15px; background-color: #1e293b; border: 1px solid #334155; padding: 20px; border-radius: 16px;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(124, 58, 237, 0.15); display: flex; align-items: center; justify-content: center; color: #a78bfa; font-size: 20px;">
                    <i class="fa fa-headphones"></i>
                </div>
                <div>
                    <div style="font-size: 16px; font-weight: bold; color: #ffffff;">پشتیبانی مستمر</div>
                    <div style="font-size: 12px; color: #94a3b8;">همراهی تا یادگیری کامل</div>
                </div>
            </div>

        </div>

    </div>
</div>

@section scripts {
    <script>
        var currentHeroIndex = 1;
        var heroTimer = null;

        function renderHeroSlider(index) {
            var slides = document.getElementsByClassName("hero-slide");
            var dots = document.getElementsByClassName("hero-dot");
            if (!slides || slides.length === 0) return;

            if (index > slides.length) { currentHeroIndex = 1; }
            if (index < 1) { currentHeroIndex = slides.length; }

            for (var i = 0; i < slides.length; i++) {
                if (i === (currentHeroIndex - 1)) {
                    slides[i].style.opacity = "1";
                    slides[i].style.zIndex = "20";
                } else {
                    slides[i].style.opacity = "0";
                    slides[i].style.zIndex = "10";
                }
            }

            for (var i = 0; i < dots.length; i++) {
                if (i === (currentHeroIndex - 1)) {
                    dots[i].style.width = "24px";
                    dots[i].style.backgroundColor = "#3b82f6";
                } else {
                    dots[i].style.width = "8px";
                    dots[i].style.backgroundColor = "rgba(255,255,255,0.4)";
                }
            }
        }

        window.plusHeroSlide = function (n) {
            currentHeroIndex += n;
            renderHeroSlider(currentHeroIndex);
            resetHeroTimer();
        };

        window.setHeroSlide = function (n) {
            currentHeroIndex = n;
            renderHeroSlider(currentHeroIndex);
            resetHeroTimer();
        };

        function autoStepHero() {
            currentHeroIndex++;
            renderHeroSlider(currentHeroIndex);
        }

        function resetHeroTimer() {
            if (heroTimer) clearInterval(heroTimer);
            heroTimer = setInterval(autoStepHero, 5500);
        }

        document.addEventListener("DOMContentLoaded", function () {
            renderHeroSlider(currentHeroIndex);
            resetHeroTimer();
        });
    </script>
}
