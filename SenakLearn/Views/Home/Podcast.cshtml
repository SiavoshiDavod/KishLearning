@model IEnumerable<SenakLearn.Models.learn_cours>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "پادکست‌های آموزشی کیش";
}

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
        <!-- Title & Intro -->
        <div class="text-center max-w-2xl mx-auto mb-10">
            <h1 class="text-3xl font-titr text-gray-900 mb-2">رادیو و پادکست‌های تخصصی</h1>
            <p class="text-sm text-gray-500">محتوای صوتی ارزشمند، نکات کلیدی و آموزش‌های کوتاه برای یادگیری در هر زمان</p>
        </div>

        <!-- Filter -->
        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-10 max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-3">
            @Html.Cours_Group_DropDown("groupId", false, new { @class = "border border-gray-200 rounded-xl px-3 py-2 text-sm", @id = "filter_pod_group" }, "دسته‌بندی...", (int?)ViewBag.groupId, null, true)
            @Html.Teacher_DropDown("teacherId", false, new { @class = "border border-gray-200 rounded-xl px-3 py-2 text-sm", @id = "filter_pod_teacher" }, "گوینده / مدرس...", (int?)ViewBag.teacherId)
            <input type="text" id="filter_pod_keyword" value="@ViewBag.keyword" placeholder="جستجو در پادکست‌ها..." class="border border-gray-200 rounded-xl px-4 py-2 text-sm" />
            <button onclick="ReloadPodcast()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl py-2 text-sm transition">جستجو</button>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="relative h-44 bg-gray-100">
                                <img src="@(!string.IsNullOrEmpty(item.image) ? "/images/cours/" + item.image : "/images/book/default-book.png")" alt="@item.name" class="w-full h-full object-cover" onerror="this.src='/assets/img/preview.jpg'" />
                                <div class="absolute bottom-3 right-3 bg-black/70 backdrop-blur-sm text-white text-xs px-2.5 py-1 rounded-full flex items-center gap-1.5">
                                    <i class="fa fa-headphones"></i> @item.time دقیقه
                                </div>
                            </div>
                            <div class="p-5">
                                <h3 class="font-titr text-base text-gray-900 mb-2">@item.name</h3>
                                <p class="text-xs text-gray-500 line-clamp-2">@item.doc</p>
                            </div>
                        </div>

                        <div class="p-5 pt-0">
                            <div class="flex items-center justify-between pt-3 border-t border-gray-100 text-sm">
                                <div>
                                    @if (item.Monetary != null && item.Monetary > 0)
                                    {
                                        <del class="text-xs text-gray-400 ml-1 format-price">@item.Monetary</del>
                                        <span class="text-emerald-600 font-bold format-price">@item.PriceAfterDiscount</span> <span class="text-xs text-gray-500">تومان</span>
                                    }
                                    else
                                    {
                                        <span class="text-emerald-600 font-bold text-xs bg-emerald-50 px-2.5 py-1 rounded-full">رایگان</span>
                                    }
                                </div>
                                <a onclick="countPreviewItemByClient('@SenakLearn.Models.ObjCount.objType_Podcast','@item.id')" href="/DetailsPodcast/Index?type=2&id=@item.id" class="text-blue-600 hover:text-blue-700 text-xs font-bold flex items-center gap-1">
                                    شنیدن پادکست <i class="fa fa-arrow-left"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@section scripts {
    <script>
        function ReloadPodcast() {
            var g = $("#filter_pod_group").val() || "";
            var t = $("#filter_pod_teacher").val() || "";
            var k = $("#filter_pod_keyword").val() || "";
            window.location.href = "/home/Podcast?groupId=" + encodeURIComponent(g) + "&teacherId=" + encodeURIComponent(t) + "&keyword=" + encodeURIComponent(k);
        }
        $(document).ready(function () {
            $('.format-price').each(function () {
                var txt = $(this).text();
                $(this).text(txt.replace(/\B(?=(\d{3})+(?!\d))/g, ","));
            });
        });
    </script>
}

