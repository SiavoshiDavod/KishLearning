@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "آزمون‌های آنلاین";

    SenakLearn.Models.AzmoonEntityType? azmoonEntityType =
        (SenakLearn.Models.AzmoonEntityType?)ViewBag.azmoonEntityType;

    var azmoons = SenakLearn.Biz.AzmoonEntityBiz.Instance
        .GetAllActive(azmoonEntityType, x => x.Status)
        .ToList();
}

<style>
    /* استایل استاندارد دکمه آبی منطبق بر ShowAllClasses */
    .btn-view-blue {
        background-color: #eff6ff; /* bg-blue-50 */
        color: #2563eb !important; /* text-blue-600 */
    }

        .btn-view-blue:hover {
            background-color: #2563eb !important; /* bg-blue-600 */
            color: #ffffff !important; /* رنگ متن کاملاً سفید و واضح */
        }
</style>

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">

        <!-- سربرگ صفحه -->
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h1 class="text-3xl font-titr text-gray-900 mb-2">
                آزمون‌های آنلاین
            </h1>
            <p class="text-sm text-gray-500">
                آزمون موردنظر خود را پیدا کنید و برای شرکت در آن وارد صفحه آزمون شوید.
            </p>
        </div>

        <!-- فیلتر و جستجو -->
        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-10">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <input type="text"
                       id="azmoonKeyword"
                       placeholder="جستجو بر اساس نام یا عنوان آزمون..."
                       class="md:col-span-3 border border-gray-200 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-100" />

                <button type="button"
                        id="azmoonSearchButton"
                        class="bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl py-2 text-sm transition">
                    جستجو
                </button>
            </div>
        </div>

        <!-- عنوان بخش آزمون‌ها -->
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-titr text-gray-900 border-r-4 border-blue-600 pr-3">
                فهرست آزمون‌ها
            </h2>
        </div>

        <!-- گرید کارت‌های آزمون -->
        <div id="azmoonList" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var item in azmoons)
            {
                var azmoonUrl = Url.Action("Azmoon", "Home", new { Id = item.Id });

                <article class="azmoon-card bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between"
                         data-search="@(item.Name + " " + item.Title + " " + item.Description)">

                    <div>
                        <div class="h-40 bg-gray-100 overflow-hidden relative">
                            <img src="@Url.Content("~/images/Azmoon/" + item.AzmoonImageUrl)"
                                 alt="@item.Title"
                                 class="w-full h-full object-cover"
                                 onerror="this.onerror=null; this.src='@Url.Content("~/images/cours/no-photo.jpg")';" />

                            @if (item.IsFavorite)
                            {
                                <span class="absolute top-3 right-3 bg-amber-100 text-amber-700 text-xs font-bold px-3 py-1 rounded-full">
                                    آزمون منتخب
                                </span>
                            }
                        </div>

                        <div class="p-4">
                            <h3 class="font-titr text-sm text-gray-900 line-clamp-1">
                                @item.Name
                            </h3>

                            <p class="text-xs text-blue-600 mt-2 line-clamp-1">
                                @item.Title
                            </p>

                            <p class="text-xs text-gray-500 mt-3 leading-6 line-clamp-2">
                                @item.Description
                            </p>
                        </div>
                    </div>

                    <div class="p-4 pt-0">
                        <a href="@azmoonUrl"
                           class="block text-center text-xs font-bold py-2 rounded-xl transition-all duration-200 btn-view-blue">
                            مشاهده و شرکت در آزمون
                        </a>
                    </div>
                </article>
            }
        </div>

        <!-- پیام نبود نتیجه -->
        <div id="azmoonEmptyMessage"
             class="@(azmoons.Any() ? "hidden " : "")bg-white border border-gray-100 rounded-2xl p-8 text-center text-sm text-gray-500">
            آزمونی برای نمایش پیدا نشد.
        </div>
    </div>
</section>

@section scripts {
    <script>
        (function () {
            var input = document.getElementById('azmoonKeyword');
            var searchButton = document.getElementById('azmoonSearchButton');
            var cards = Array.prototype.slice.call(
                document.querySelectorAll('.azmoon-card')
            );
            var emptyMessage = document.getElementById('azmoonEmptyMessage');

            if (!input || !searchButton || !emptyMessage) {
                return;
            }

            function filterAzmoons() {
                var keyword = input.value.trim().toLowerCase();
                var visibleCount = 0;

                cards.forEach(function (card) {
                    var searchableText = (card.getAttribute('data-search') || '').toLowerCase();
                    var isVisible = searchableText.indexOf(keyword) !== -1;

                    card.classList.toggle('hidden', !isVisible);

                    if (isVisible) {
                        visibleCount++;
                    }
                });

                emptyMessage.classList.toggle('hidden', visibleCount > 0);
            }

            searchButton.addEventListener('click', filterAzmoons);
            input.addEventListener('input', filterAzmoons);
            input.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    filterAzmoons();
                }
            });
        })();
    </script>
}
