@model SenakLearn.Models.learn_cours
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model != null ? Model.name : "جزئیات دوره آموزشی";
}

@if (Model != null)
{
    <section class="py-12 bg-gray-50">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="bg-white rounded-3xl p-6 sm:p-10 border border-gray-100 shadow-sm space-y-8">
                <!-- Header / Intro -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center border-b border-gray-100 pb-8">
                    <div class="md:col-span-1 aspect-[4/3] rounded-2xl overflow-hidden bg-gray-100 shadow-inner">
                        <img src="/images/cours/@Model.image" alt="@Model.name" class="w-full h-full object-cover" onerror="this.src='/assets/img/preview.jpg'" />
                    </div>
                    <div class="md:col-span-2 space-y-4">
                        <span class="bg-blue-50 text-blue-600 text-xs px-3 py-1 rounded-full font-bold">
                            @(Model.learn_cours_group != null ? Model.learn_cours_group.name : "دوره آموزشی")
                        </span>
                        <h1 class="text-2xl sm:text-3xl font-titr text-gray-900">@Model.name</h1>

                        <div class="flex flex-wrap gap-6 text-xs text-gray-500 pt-2">
                            <div><i class="fa fa-clock ml-1 text-blue-500"></i> مدت دوره: <strong class="text-gray-800">@Model.time</strong></div>
                            <div><i class="fa fa-chalkboard-teacher ml-1 text-blue-500"></i> مدرس: <strong class="text-gray-800">@(Model.learn_teacher != null ? Model.learn_teacher.name : "مدرس کیش")</strong></div>
                        </div>
                    </div>
                </div>

                <!-- Course Description & Docs -->
                <div class="space-y-6">
                    <div class="space-y-2">
                        <h3 class="font-titr text-lg text-gray-900">معرفی و سرفصل‌های دوره</h3>
                        <div class="text-sm text-gray-600 leading-relaxed">
                            @Html.DisplayFor(model => model.doc)
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.doc2))
                    {
                        <div class="space-y-2 pt-6 border-t border-gray-100">
                            <h3 class="font-titr text-lg text-gray-900">توضیحات تکمیلی</h3>
                            <div class="text-sm text-gray-600 leading-relaxed rich-text-wrapper">
                                @Html.Raw(Model.doc2)
                            </div>
                        </div>
                    }
                </div>

                <!-- User Comments Section (Child Actions) -->
                <div class="pt-8 border-t border-gray-100 space-y-6">
                    <h3 class="font-titr text-xl text-gray-900">دیدگاه‌ها و پرسش‌های کاربران</h3>

                    <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200">
                        <div id="list" class="space-y-4">
                            @Html.Action("ShowComments")
                        </div>
                        <div class="mt-8 pt-6 border-t border-gray-200">
                            @Html.Action("CreateComment")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

