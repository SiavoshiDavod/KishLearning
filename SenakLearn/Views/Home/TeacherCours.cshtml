                <p class="abs">@Html.Raw(Model.Resume)</p>
            </div>
        </div>
    </div>
    <div class="container popular">
        <h4>دوره های @Model.FullName</h4>
        <div class="row tutorials">
            @foreach (var item in Model.learn_cours)
            {
                <div class="col-md-4">
                    <div class="product text-center mb-4">
                        <div class="product-image">
                            <img class="img-fluid center-block" src="/images/cours/@item.image" alt="@item.name">
                            <div class="product-overlay">
                                <div class="add-to-cart">
                                    <a href="/DetailsCours/Index?type=1&id=@item.id">نمایش دوره</a>
                                </div>
                            </div>
                        </div>
                        <div class="product-des">
                            @*<div class="product-title">
                                    <a href="/DetailsCours/Index?type=1&id=@item.id">@item.name</a>
                                </div>*@
                            <div class="product-title">
                                <a href="/DetailsCours/Index?type=1&id=@item.id">@item.name</a>
                            </div>
                            <div class="product-price">
                                @item.doc
                            </div>
                            <div class="product-rating">
                                <span class="lessons">
                                    <i class="fa fa-building-o"></i>
                                    @item.num_present جلسه
                                </span>
                                <span class="duration">
                                    <i class="fa fa-clock-o"></i>
                                    @item.time ساعت
                                </span>
                            </div>
                            @*<div class="product-price">
                                    <del>26 ه ت</del> <ins>13 ه ت</ins>
                                </div>*@
                        </div>
                    </div>
                </div>
            }
        </div>
