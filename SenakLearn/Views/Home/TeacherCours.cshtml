<div id="teacher-single" class=" page">
    <div class="container teacher-page">
        <div class="row">
            <div class="col-sm-3 text-center float-right">
                <img style=" max-width: 100%; height: auto;" src="/images/teacher/@Model.image" alt="Avatar" class="teacher-avatar">
