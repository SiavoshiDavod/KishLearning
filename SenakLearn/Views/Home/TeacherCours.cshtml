@model SenakLearn.Models.learn_teacher
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "صفحه استاد";
}

<style>
    /* ==================== فونت‌ها و استایل کلی صفحه ==================== */
    body {
        font-family: 'Byekan', 'IRANSANSExpanded', Tahoma, sans-serif;
    }

    .teacher-titles, h1, h2, h3, h4, h5, h6, .teacher-numbers {
        font-family: 'Btraffic', 'IRANSans-Bold', Tahoma, sans-serif;
    }

    .teacher-detail-wrapper {
        padding: 45px 0 80px;
        background: #f8fafc;
        min-height: 100vh;
        box-sizing: border-box;
    }

    /* ==================== سایدبار پروفایل استاد (سمت راست) ==================== */
    .teacher-sticky-sidebar {
        position: sticky;
        top: 25px;
        z-index: 10;
        width: 100%;
        box-sizing: border-box;
    }

    .teacher-profile-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        padding: 30px 24px;
        text-align: center;
        margin-bottom: 22px;
        box-sizing: border-box;
        width: 100%;
    }

    .teacher-avatar-wrapper {
        position: relative;
        width: 150px;
        height: 150px;
        margin: 0 auto 22px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid #e2e8f0;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        background: #f1f5f9;
    }

        .teacher-avatar-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .teacher-fullname {
        font-size: 1.35rem;
        font-weight: 800;
        color: #1e293b;
        margin: 0 0 10px;
        padding: 0;
    }

    .teacher-education-badge {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        padding: 6px 18px;
        border-radius: 24px;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    /* اطلاعات تماس و متادیتا */
    .teacher-meta-list {
        text-align: right;
        border-top: 1px solid #f1f5f9;
        padding-top: 20px;
        margin-top: 6px;
    }

    .teacher-meta-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        color: #475569;
        margin-bottom: 13px;
        font-weight: 600;
        word-break: break-word;
    }

        .teacher-meta-item i {
            color: #007bff;
            width: 20px;
            text-align: center;
            flex-shrink: 0;
        }

    /* ==================== کارت‌های دوره‌های استاد (ستون سمت چپ) ==================== */
    .content-box-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
        padding: 28px;
        margin-bottom: 22px;
        box-sizing: border-box;
        width: 100%;
    }

    .content-box-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 26px;
        padding-bottom: 14px;
        border-bottom: 2px solid #f1f5f9;
    }

        .content-box-header h4 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 800;
            color: #1e293b;
        }

        .content-box-header i {
            color: #007bff;
            font-size: 1.35rem;
        }

    /* گرید دوره‌ها */
    .teacher-courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        width: 100%;
    }

    .course-item-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        width: 100%;
    }

        .course-item-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.09);
            border-color: #cbd5e1;
        }

    .course-img-wrap {
        position: relative;
        height: 175px;
        background: #f1f5f9;
        overflow: hidden;
    }

        .course-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
            display: block;
        }

    .course-item-card:hover .course-img-wrap img {
        transform: scale(1.06);
    }

    .course-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        box-sizing: border-box;
    }

    .course-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 8px;
        text-decoration: none !important;
        line-height: 1.5;
    }

        .course-title:hover {
            color: #007bff;
        }

    .course-desc {
        font-size: 0.88rem;
        color: #64748b;
        line-height: 1.7;
        margin-bottom: 15px;
        flex-grow: 1;
        overflow: hidden;
    }

    .course-footer-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #f1f5f9;
        padding-top: 12px;
        font-size: 0.82rem;
        color: #64748b;
        font-weight: 600;
    }

    .btn-view-course {
        display: block;
        width: 100%;
        padding: 11px 0;
        background: #eff6ff;
        color: #2563eb;
        text-align: center;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none !important;
        transition: all 0.2s ease;
        margin-top: 12px;
        box-sizing: border-box;
    }

        .btn-view-course:hover {
            background: #2563eb;
            color: #ffffff !important;
        }

    /* ریسپانسیو */
    @@media (max-width: 991px) {
        .teacher-sticky-sidebar {
            position: static;
        }

        .teacher-detail-wrapper {
            padding: 25px 0 50px;
        }
    }
</style>

<div class="teacher-detail-wrapper">
    <div class="container">
        @if (Model == null)
        {
            <div class="alert alert-warning text-center">مدرس مورد نظر یافت نشد.</div>
        }
        else
        {
            <div class="row">

                @* ============ سایدبار سمت راست: پروفایل و اطلاعات استاد ============ *@
                <div class="col-lg-4 col-md-5 mb-4">
                    <div class="teacher-sticky-sidebar">
                        <div class="teacher-profile-card">

                            <div class="teacher-avatar-wrapper">
                                @{
                                    var avatarImg = !string.IsNullOrEmpty(Model.image)
                                        ? "/images/teacher/" + Model.image
                                        : "/images/avatar.png";
                                }
                                <img src="@avatarImg" alt="@Model.FullName" onerror="this.src='/images/avatar.png';">
                            </div>

                            <h1 class="teacher-fullname">@Model.FullName</h1>
                            <span class="teacher-education-badge">@Model.education</span>

                            <div class="teacher-meta-list">
                                @if (!string.IsNullOrEmpty(Model.mobile))
                                {
                                    <div class="teacher-meta-item">
                                        <i class="fa fa-phone"></i>
                                        <span>تلفن همراه: @Model.mobile</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.email))
                                {
                                    <div class="teacher-meta-item">
                                        <i class="fa fa-envelope"></i>
                                        <span>ایمیل: @Model.email</span>
                                    </div>
                                }
                                <div class="teacher-meta-item">
                                    <i class="fa fa-book"></i>
                                    <span class="teacher-numbers">@(Model.learn_cours != null ? Model.learn_cours.Count : 0)</span>
                                    <span>دوره</span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                @* ============ بخش اصلی سمت چپ: دوره‌ها و پادکست‌های استاد ============ *@
                <div class="col-lg-8 col-md-7">
                    <div class="content-box-card">

                        <div class="content-box-header">
                            <i class="fa fa-graduation-cap"></i>
                            <h4>دوره‌ها و پادکست‌های استاد @Model.FullName</h4>
                        </div>

                        @if (Model.learn_cours == null || !Model.learn_cours.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fa fa-info-circle fa-2x mb-2"></i>
                                <p>هنوز دوره‌ای برای این استاد ثبت نشده است.</p>
                            </div>
                        }
                        else
                        {
                            <div class="teacher-courses-grid">
                                @foreach (var item in Model.learn_cours)
                                {
                                    var courseImg = !string.IsNullOrEmpty(item.image)
                                        ? "/images/cours/" + item.image
                                        : "/images/logo.png";

                                    <div class="course-item-card">
                                        <div class="course-img-wrap">
                                            <img src="@courseImg" alt="@item.name" onerror="this.src='/images/logo.png';">
                                        </div>
                                        <div class="course-body">
                                            <a href="/DetailsCours/Index?type=1&id=@item.id" class="course-title">@item.name</a>
                                            <p class="course-desc">@item.doc</p>

                                            <div class="course-footer-meta">
                                                <span><i class="fa fa-file-text-o"></i> @item.num_present جلسه</span>
                                                <span class="teacher-numbers"><i class="fa fa-clock-o"></i> @item.time ساعت</span>
                                            </div>

                                            <a href="/DetailsCours/Index?type=1&id=@item.id" class="btn-view-course">
                                                مشاهده و ثبت نام دوره
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                    </div>
                </div>

            </div>
        }
    </div>
</div>
