@using SenakLearn.Models.Common
@using SenakLearn.Models.wrapper
@model LearnWrapper
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "تمام دوره‌ها و منابع آموزشی";
    int? groupId = ViewBag.groupId;
    int? teacherId = ViewBag.teacherId;
    string keyword = ViewBag.keyword;

}
<style>
    /* دکمه آبی (کلاس آنلاین) */
    .btn-view-blue {
        background-color: #eff6ff; /* bg-blue-50 */
        color: #2563eb !important; /* text-blue-600 */
    }

    .btn-view-blue:hover {
        background-color: #2563eb !important; /* bg-blue-600 */
        color: #ffffff !important; /* متن حتما سفید شود */
    }

    /* دکمه سبز (فیلم آموزشی) */
    .btn-view-emerald {
        background-color: #ecfdf5; /* bg-emerald-50 */
        color: #059669 !important; /* text-emerald-600 */
    }

        .btn-view-emerald:hover {
            background-color: #059669 !important; /* bg-emerald-600 */
            color: #ffffff !important; /* متن حتما سفید شود */
        }
</style>

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
        <!-- Header & Tabs -->
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h1 class="text-3xl font-titr text-gray-900 mb-2">جامع‌ترین دوره‌های آموزشی</h1>
            <p class="text-sm text-gray-500">مشاهده همزمان کلاس‌های آنلاین زنده و فیلم‌های آموزشی مالتی‌مدیا</p>
        </div>

        <!-- Filter Row -->
        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-10 grid grid-cols-1 md:grid-cols-4 gap-4">
            @Html.Cours_Group_DropDown("groupId", false, new { @class = "border border-gray-200 rounded-xl px-3 py-2 text-sm", @id = "all_group" }, "دسته‌بندی...", groupId, null, true)
            @Html.Teacher_DropDown("teacherId", false, new { @class = "border border-gray-200 rounded-xl px-3 py-2 text-sm", @id = "all_teacher" }, "مدرس...", teacherId)
            <input type="text" id="all_keyword" value="@keyword" placeholder="جستجو بر اساس عنوان دوره..." class="border border-gray-200 rounded-xl px-4 py-2 text-sm" />
            <button onclick="ReloadAllClasses()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl py-2 text-sm transition">جستجو و فیلتر</button>
        </div>

        <!-- SECTION 1: Online Classes -->
        <div class="mb-14">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-titr text-gray-900 border-r-4 border-blue-600 pr-3">کلاس‌های آنلاین زنده</h2>
                <a href="/home/OnlineClass" class="text-xs text-blue-600 hover:text-blue-700 font-bold">مشاهده همه کلاس‌های آنلاین &larr;</a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var item in Model.listOnlineClass)
                {
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="h-40 bg-gray-100 overflow-hidden">
                                <img src="@(!string.IsNullOrEmpty(item.InterviewPathImage) ? "/images/Interview/" + item.InterviewPathImage : "/images/cours/no-photo.jpg")" alt="@item.name" class="w-full h-full object-cover" onerror="this.src='/images/cours/no-photo.jpg'" />
                            </div>
                            <div class="p-4">
                                <h3 class="font-titr text-sm text-gray-900 line-clamp-1">@item.name</h3>
                                <p class="text-xs text-gray-500 mt-2"><i class="fa fa-clock ml-1"></i> @item.Time ساعت - @item.SessionCount جلسه</p>
                            </div>
                        </div>
                        <div class="p-4 pt-0">
                            <a href="/DetailsOnlineClass/Index?type=2&id=@item.Id"
                               class="block text-center text-xs font-bold py-2 rounded-xl transition-all duration-200 btn-view-blue">
                                مشاهده کلاس
                            </a>

                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- SECTION 2: Video Courses -->
        <div>
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-titr text-gray-900 border-r-4 border-emerald-600 pr-3">فیلم‌های آموزشی ضبط‌شده</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var item in Model.listCourse)
                {
                    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="h-40 bg-gray-100 overflow-hidden">
                                <img src="@(!string.IsNullOrEmpty(item.image) ? "/images/cours/" + item.image : "/images/cours/no-photo.jpg")" alt="@item.doc" class="w-full h-full object-cover" onerror="this.src='/images/cours/no-photo.jpg'" />
                            </div>
                            <div class="p-4">
                                <h3 class="font-titr text-sm text-gray-900 line-clamp-1">@item.name</h3>
                                <p class="text-xs text-gray-500 mt-2"><i class="fa fa-video ml-1"></i> @item.time ساعت آموزش تخصصی</p>
                            </div>
                        </div>
                        <div class="p-4 pt-0">
                            <a href="/DetailsCours/Index?type=1&id=@item.id"
                               class="block text-center text-xs font-bold py-2 rounded-xl transition-all duration-200 btn-view-emerald">
                                نمایش دوره
                            </a>

                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>
        function ReloadAllClasses() {
            var g = $("#all_group").val() || "";
            var t = $("#all_teacher").val() || "";
            var k = $("#all_keyword").val() || "";
            window.location.href = "/home/ShowAllClasses?groupId=" + encodeURIComponent(g) + "&teacherId=" + encodeURIComponent(t) + "&keyword=" + encodeURIComponent(k);
        }
    </script>
}

