                                        @item.num_present جلسه
                                    </span>
                                    <span class="duration">
                                        <i class="fa fa-clock-o"></i>
                                        @item.time ساعت
                                    </span>
                                </div>
                                @*<div class="product-price">
                                        <del>26 ه ت</del> <ins>13 ه ت</ins>
                                    </div>*@
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
