</section>
<section class="shop grid page-section-ptb">
    <div class="container ">
        <div class="text-center">
            <h3>کتاب های آموزشی</h3>
        </div>
        <div>

            @if (!Model.DataPage.Any())
            {
                <span> موردی یافت نشد</span>
            }
            else
            {
                <div class="row">
                    @foreach (var item in Model.DataPage)
                    {
                        <div class="col-md-4">
                            <div class="product text-center mb-4">
                                <div class="product-image">
                                    <img class="img-fluid center-block" src="/images/book/@item.ScreenShotId" alt="@item.TitleF">
                                    <div class="product-overlay">
                                        <div class="add-to-cart">
                                            <a href="/Books/detail?Id=@item.Id">نمایش کتاب</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="product-des">
                                    <div class="product-title">
                                        <a href="/Books/detail?Id=@item.Id">@item.TitleF</a>
                                    </div>
                                    <div class="product-title">
                                        <a href="/Books/detail?Id=@item.Id">@item.Title</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="row">
                    <nav class="center-block">
                        <div class="navigation" style="text-align: center">
                            <ul class="pagination">
                                @*<li class="page-item @Model.PreviousClass"><a class="page-link" href="?page=@(@Model.Previous+@Model.Query)">&laquo;</a></li>*@
                                @for (int _page = 1; _page <= Model.CountPage; _page++)
                                {
                                    if (_page == Model.CurrentPage)
                                    {
                                       <li class="page-item " style="font-weight: bolder;"><a class="page-link" style="background-color: lightgray" href="?page=@_page ">@_page</a></li>
                                    }
                                    else
                                    {
                                        <li class="page-item "><a class="page-link" href="?page=@_page ">@_page</a></li>
                                    }
                                }
                                @*<li class="page-item @Model.NextClass"><a class="page-link" href="?page=@(@Model.Next+@Model.Query)">&raquo;</a></li>*@
                            </ul>
                        </div>
                    </nav>
                </div>
            }
        </div>
    </div>
</section>
<section class="shop grid page-section-ptb">
    <div id="mainPaper" class="container ">
        <div class="text-center">
            <h3>مقالات آموزشی</h3>
        </div>
        <div class="row tutorial ">
            @if (!listPaper.Any())
            {
                <span> موردی یافت نشد</span>
            }
            else
            {

                foreach (var item in listPaper)
                {
                    <div class="col-xs-12 col-sm-12 col-md-6">
                        <div class="tutorial-details">
                            <div class="pull-right fav favorite">
                                <i class="zmdi zmdi-star"></i>
                            </div>
                            <h6>@item.TitleF</h6>
                            <p><span class="duration"><i class="zmdi zmdi-time"></i>@item.Year </span></p>
                            <p class="abs">@item.Title</p>
                            <a href="/paper/detail?Id=@item.Id" class="greybutton">نمایش مقاله</a>
                        </div>
                    </div>
                }


            }
        </div>
    </div>
</section>
<script>
    function paging(currentPage, pages, divId) {
        if (pages <= 1) {
            return "";
        }
        var htm = '<div class="row text-center"><div class="col-xs-12"><div class="paginations">';
        if (currentPage > 1) {
            var i = currentPage - 1;
            htm += '<a class="prev" onclick="showClasses(' + i + ')"><i class="zmdi zmdi-chevron-right"></i>قبلی</a>';
        }
        for (var i = 1; i < pages; i++) {
            htm += '<a onclick="showClasses(' + i + ')">' + i + '</a>';
        }
        if (currentPage < pages) {
            var i = currentPage + 1;
            htm += '<a class="next" onclick="showClasses(' + i + ')">بعدی<i class="zmdi zmdi-chevron-left"></i></a>';
        }
        htm += '</div></div></div>';
        $('#' + divId).html(htm);
    }
    function showClasses(page) {

    }
</script>
<script>
    function ReloadPage() {
        window.location.href = "/home/ShowAllClasses?groupId=" + $('#CoursGroupId').val() + "&teacherId=" + $('#TeacherId').val() + "&keyword=" + $('#keywords').val();
    }

</script>



