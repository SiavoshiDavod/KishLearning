@using SenakLearn.Models.Common
@using SenakLearn.Models
@model Pagination<Book>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var count = 0;
    int? groupId = ViewBag.groupId;
    int? teacherId = ViewBag.teacherId;
    string keyword = ViewBag.keyword;
    var onlineClass = SenakLearn.Biz.OnlineClassBiz.Instance.GetAllPage(i => i.ClassType != SenakLearn.Enums.OnlineClassType.Archived && (groupId == null || groupId == i.id_learn_cours_group) && (teacherId == null || teacherId == i.id_learn_teacher) && (string.IsNullOrEmpty(keyword) || i.name.Contains(keyword)), 0, 50);
    var listCourse = SenakLearn.Biz.CourseBiz.Instance.GetAllPage(i => i.status && (groupId == null || groupId == i.id_group) && (teacherId == null || teacherId == i.id_teacher) && (string.IsNullOrEmpty(keyword) || i.name.Contains(keyword)), 0, 50);
    var listPaper = SenakLearn.Biz.PaperBiz.Instance.GetAllPage(i => (groupId == null || groupId == i.GroupId) && (string.IsNullOrEmpty(keyword) || i.Keyword.Contains(keyword)), 0, 50);
    Pagination<Book> listBook = new Pagination<Book>();
    listBook.Data = SenakLearn.Biz.BookBiz.Instance.GetAllBooks(i => (groupId == null || groupId == i.GroupId) && (string.IsNullOrEmpty(keyword) || i.Keyword.Contains(keyword)));
}
<div class="row ">
    <div class="col-md-3 col-sm-6 col-xs-12   search-button select-categories">

        @Html.Cours_Group_DropDown("CoursGroupId", false, new { @class = "jquery-select" }, "یک دسته را انتخاب کنید", (int?)ViewBag.groupId, null, true)
    </div>
    <div class="col-md-3 col-sm-6 col-xs-12  search-button select-numofvids">
        @Html.Teacher_DropDown("TeacherId", false, new { @class = "jquery-select" }, "یک مدرس را انتخاب کنید", (int?)ViewBag.teacherId)
    </div>

    <div class="col-sm-3 col-xs-6  search-button text-keywords float-right">
        <input class="keywords form-control placeholder" name="keywords" id="keywords" type="text" placeholder="کلمات کلیدی" value="@ViewBag.keyword">
    </div>
    <div class="col-sm-3 col-xs-6 search-button text-center">
        <button class="search-teachers button " onclick="ReloadPage()">جستجو</button>
    </div>
</div>
<section class="shop grid page-section-ptb">
    <div class="container ">
        <div class="text-center">
            <h3>آموزش های آنلاین</h3>
        </div>
        <div class="row">
            @if (!onlineClass.Any())
            {
                <span> موردی یافت نشد</span>
            }
            else
            {
                foreach (var item in onlineClass)
                {
                    <div class="col-md-4">
                        <div class="product text-center mb-4">
                            <div class="product-image">
                                <img class="img-fluid center-block" src="/images/Interview/@item.InterviewPathImage" alt="@item.name">
                                <div class="product-overlay">
                                    <div class="add-to-cart">
                                        <a href="/DetailsOnlineClass/Index?type=2&id=@item.Id">نمایش دوره</a>
                                    </div>
                                </div>
                            </div>
                            <div class="product-des">
                                @*<div class="product-title">
                                        <a href="/DetailsCours/Index?type=1&id=@item.id">@item.name</a>
                                    </div>*@
                                <div class="product-title">
                                    <a href="/DetailsOnlineClass/Index?type=2&id=@item.Id">@item.name</a>
                                </div>
                                <div class="product-price">
                                    @item.Description
                                </div>
                                <div class="product-rating">
                                    <span class="lessons">
                                        <i class="fa fa-building-o"></i>
                                        @item.SessionCount جلسه
                                    </span>
                                    <span class="duration">
                                        <i class="fa fa-clock-o"></i>
                                        @item.Time ساعت
                                    </span>
                                </div>
                                @*<div class="product-price">
                                        <del>26 ه ت</del> <ins>13 ه ت</ins>
                                    </div>*@
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<section class="shop grid page-section-ptb">
    <div class="container ">
        <div class="text-center">
            <h3>فیلمهای آموزشی</h3>
        </div>
        <div class="row">

            @if (!listCourse.Any())
            {
                <span> موردی یافت نشد</span>
            }
            else
            {
                foreach (var item in listCourse)
                {
                    <div class="col-md-4">
                        <div class="product text-center mb-4">
                            <div class="product-image">
                                <img class="img-fluid center-block" src="/images/cours/@item.image" alt="@item.name">
                                <div class="product-overlay">
                                    <div class="add-to-cart">
                                        <a href="/DetailsCours/Index?type=1&id=@item.id">نمایش دوره</a>
                                    </div>
                                </div>
                            </div>
                            <div class="product-des">
                                @*<div class="product-title">
                                        <a href="/DetailsCours/Index?type=1&id=@item.id">@item.name</a>
                                    </div>*@
                                <div class="product-title">
                                    <a href="/DetailsCours/Index?type=1&id=@item.id">@item.name</a>
                                </div>
                                <div class="product-price">
                                    @item.doc
                                </div>
                                <div class="product-rating">
