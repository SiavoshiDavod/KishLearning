@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "نظرسنجی‌های فعال و فرم‌های ارزیابی";
    var activeSurveys = SenakLearn.Biz.SurveyEntityBiz.Instance.GetAllActive(x => x.Status);
}

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-titr text-gray-900 mb-2">فرم‌های نظرسنجی و ارزیابی کیفیت</h1>
            <p class="text-sm text-gray-500">نظرات و بازخوردهای شما بالاترین ارزش را در توسعه خدمات کیش دارد</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @if (activeSurveys != null && activeSurveys.Any())
            {
                foreach (var item in activeSurveys)
                {
                    <div class="bg-white rounded-3xl border border-gray-100 p-6 shadow-sm hover:shadow-lg transition flex flex-col justify-between">
                        <div class="flex items-start gap-4">
                            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">
                                <i class="fa fa-poll-h text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="font-titr text-lg text-gray-900 mb-1">@item.Name</h3>
                                <p class="text-xs text-gray-500 leading-relaxed">@item.Title</p>
                            </div>
                        </div>

                        <div class="pt-6 mt-6 border-t border-gray-100 flex items-center justify-between">
                            <span class="text-xs text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full font-bold">فرم فعال</span>
                            <a href="/Home/Survey?Id=@item.Id" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-5 py-2.5 rounded-xl transition flex items-center gap-2">
                                شروع نظرسنجی <i class="fa fa-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full text-center py-16 text-gray-400">
                    <i class="fa fa-clipboard-check text-4xl mb-3"></i>
                    <p>در حال حاضر هیچ فرم نظرسنجی فعالی وجود ندارد.</p>
                </div>
            }
        </div>
    </div>
</section>

