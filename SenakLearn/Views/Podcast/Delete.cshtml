@model SenakLearn.Models.learn_cours

@{
   Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "پادکست";
}

<h3>آیا از حذف اطلاعات اطمینان دارید?</h3>
<div>

    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayName("نام پادکست")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.name)
        </dd>

        <dt>
            @Html.DisplayName("مدت پادکست")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.time)
        </dd>

        <dt>
            @Html.DisplayName("جزییات پادکست")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.doc)
        </dd>
        <dt>
            @Html.DisplayName("چه چیزی در پادکست می آموزید")
        </dt>

        <dd>
            @Html.Raw(Model.doc2)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.status)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.status)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.image)
        </dt>

        <dd>
            @if (Model.image != null)
            {
                <img class="thumbnail" width="200" src="/images/cours/@Model.image" />
            }
        </dd>

        <dt>
            @Html.DisplayName("گروه بندی پادکست")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.learn_cours_group.name)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        

        <div class="form-actions no-color">
            <input type="submit" value="حذف" class="btn btn-danger" /> |
            @Html.ActionLink("نمایش لیست", "Index")
        </div>
    }
</div>
