        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.status)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.status)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.num_present)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.num_present)
        </dd>

     
        <dt>
