@model SenakLearn.Models.Person.Person_Teacher


@{
    ViewBag.Title = SenakLearn.Models.Dictionary.ModelDictionary[typeof(SenakLearn.Models.Person.Person_Teacher)];
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var listCertificates = (List<SelectListItem>)ViewBag.CertificateList;
}
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <ol class="breadcrumb pull-right">
                <li><a href="#">پرسنل</a></li>
                <li><a href="#">@ViewBag.Title</a></li>
                <li class="active">Dashboard</li>
            </ol>
            <h4 class="page-title">@ViewBag.Title </h4>
        </div>
    </div>
</div>



@using (Html.BeginForm())
{   
    @Html.HiddenFor(model => model.Id)
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        <div class="col-md-2 text-left">
            @Html.LabelFor(model => model.TeacherName, htmlAttributes: new { @class = "control-label" })
            @*<span class="fa fa-question-circle" title="عنوان" style="color:blue"></span>*@
        </div>
        <div class="col-md-10">
            @Html.EditorFor(model => model.TeacherName, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TeacherName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-2 text-left">
            @Html.LabelFor(model => model.Mobile, htmlAttributes: new { @class = "control-label" })
            @*<span class="fa fa-question-circle" title="عنوان" style="color:blue"></span>*@
        </div>
        <div class="col-md-10">
            @Html.EditorFor(model => model.Mobile, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Mobile, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-2 text-left">
            @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label" })
            @*<span class="fa fa-question-circle" title="عنوان" style="color:blue"></span>*@
        </div>
        <div class="col-md-10">
            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-2 text-left">
            @Html.LabelFor(model => model.CertificateId, htmlAttributes: new { @class = "control-label" })
            @*<span class="fa fa-question-circle" title="عنوان" style="color:blue"></span>*@
        </div>
        <div class="col-md-10">
            @Html.DropDownListFor(model =>  Model.CertificateId, listCertificates, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CertificateId, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-2 text-left">
            @Html.LabelFor(model => model.Expertise, htmlAttributes: new { @class = "control-label" })
            @*<span class="fa fa-question-circle" title="عنوان" style="color:blue"></span>*@
        </div>
        <div class="col-md-10">
            @Html.EditorFor(model => model.Expertise, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Expertise, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="ثبت" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
     @Html.ActionLink("بازگشت", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
